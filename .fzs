fzdirtyselect(){
  local query="$1"
  local IFS=$'\n'
  local -a files=($(get_modified_files) $(get_untracked_files))
  (( ${#files} == 0 )) && { echo "No modified or untracked files."; return 1 }
  local choice
  choice=$(printf '%s\n' "${files[@]}" | fzf \
      --query="$query" \
      --no-sort --tac \
      --height 90% --ansi \
      --preview-window=up:60% \
      --bind alt-up:preview-up,alt-down:preview-down \
      --preview='
        # untracked? show whole file; otherwise show diff
        if git ls-files --others --exclude-standard --error-unmatch {} >/dev/null 2>&1; then
          pygmentize -g {}
        else
          git diff --color=always -- {}
        fi'
      )
  echo "$choice"
}
# copy a filepath from git status
fzs() {
  # copy to clipboard
  while true; do
    choice=$(fzdirtyselect "$1")
    local ret=$?
    if [[ $ret -eq 1 ]]; then
      echo "No modified or untracked files."
      return 1
    elif [[ -n $choice ]]; then
      printf %s "$choice" | pbcopy
      echo "$choice"
    else
      break
    fi
  done
}
fzd(){
  choice=$(fzdirtyselect "$1")
  # copy to clipboard
  git diff $choice
}

alias gsc=fzs