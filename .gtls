alias gdp='git diff --name-only $(gt parent)..HEAD'

get_graphite_parent(){
    local specified_branch="$1"
    gt info --branch=$specified_branch --stat=true | grep "Parent:" | awk '{print $2}'
}

select_graphite_pr_and_show_parent_diff_files_in_preview() {
    local query="$1"
    local selected_branch
    selected_branch=$(gt ls | fzf \
        --query="$query" \
        --no-mouse \
        --no-sort  \
        --tac \
        --ansi \
        --border \
        --wrap \
        --ansi \
        --preview 'cleaned=$(echo {} | sed "s/ (needs restack)$//"); branch="${cleaned##* }"; parent=$(gt info --branch=$branch --stat=true | grep "Parent:" | awk "{print \$2}"); git diff --name-only $parent..$branch')
    if [ -n "$selected_branch" ]; then
        # Strip " (needs restack)" suffix
        local cleaned="${selected_branch% (needs restack)}"
        # Get last space-delimited field
        echo "${cleaned##* }"
    fi
}

select_graphite_pr() {
    local query="$1"
    local selected_branch
    selected_branch=$(gt ls | fzf \
        --query="$query" \
        --no-mouse \
        --no-sort  \
        --tac \
        --height 90% \
        --ansi \
        --border \
        --wrap \
        --ansi \
        --preview-window=up:3 \
        --preview 'git log --oneline --graph --decorate --color=always --date=short --pretty=format:"%C(auto)%h %ad | %C(reset)%s%C(auto)%d%C(reset)[%an]" {-1}')
    if [ -n "$selected_branch" ]; then
        # Strip " (needs restack)" suffix
        local cleaned="${selected_branch% (needs restack)}"
        # Get last space-delimited field
        echo "${cleaned##* }"
    fi
}

select_graphite_pr_on_current_stack_and_show_parent_diff_files_in_preview() {
    local query="$1"
    local selected_branch
    selected_branch=$(gt ls -s | fzf \
        --query="$query" \
        --no-mouse \
        --no-sort  \
        --tac \
        --height 90% \
        --ansi \
        --border \
        --wrap \
        --ansi \
        --preview-window=up:3 \
        --preview 'cleaned=$(echo {} | sed "s/ (needs restack)$//"); branch="${cleaned##* }"; parent=$(gt info --branch=$branch --stat=true | grep "Parent:" | awk "{print \$2}"); git diff --name-only $parent..$branch')
    if [ -n "$selected_branch" ]; then
        # Strip " (needs restack)" suffix
        local cleaned="${selected_branch% (needs restack)}"
        # Get last space-delimited field
        echo "${cleaned##* }"
    fi
}

# checkout a branch
gtls() {
    # Pass any arguments to select_graphite_pr as the query.
    local fzf_query="$*"
    local branch
    branch=$(select_graphite_pr_and_show_parent_diff_files_in_preview "$fzf_query")
    if [ -n "$branch" ]; then
        echo "git checkout $branch"
        git checkout "$branch"
    fi
}

gtlss() {
    # Pass any arguments to select_graphite_pr as the query.
    local fzf_query="$*"
    local branch
    branch=$(select_graphite_pr_on_current_stack_and_show_parent_diff_files_in_preview "$fzf_query")
    if [ -n "$branch" ]; then
        echo "git checkout $branch"
        git checkout "$branch"
    fi
}

fzgt(){
    local query="$*"
    local branchname
    branchname=$(select_graphite_pr "$query")
    if [ -n "$branchname" ]; then
        echo "gt pr $branchname"
        gt pr "$branchname"
    fi
}



select_modified_file_in_current_pf() {
    local query="$1"
    local selected_filename
    selected_filename=$(git diff --name-only $(gt parent)..HEAD | fzf \
        --query="$query" \
        --no-mouse \
        --no-sort  \
        --tac \
        --ansi \
        --border \
        --wrap \
        --ansi \
        --preview 'git diff --color=always -- {}')
    if [ -n "$selected_filename" ]; then
        echo "$selected_filename"
    fi
}

# copy a modified file in the current PR
gdpc() {
    # Pass any arguments to select_git_branch as the query.
    local fzf_query="$*"
    local selected_filename
    selected_filename=$(select_modified_file_in_current_pf "$fzf_query")
    if [ -n "$selected_filename" ]; then
        echo "echo $selected_filename | pbcopy"
        echo $selected_filename | pbcopy
    fi
}