strip_ansi() {
    sed 's/\x1b\[[0-9;]*m//g'
}

strip_needs_restack_suffix() {
    sed 's/ (needs restack)$//'
}

# alias gdp='git diff --name-only $(gt parent)..HEAD'

gdp(){
    local queried_file="$1"
    if [ -n "$queried_file" ]; then
        git diff $(gt parent)..HEAD -- "$queried_file"
    else
        git diff --name-only $(gt parent)..HEAD
    fi
}

get_graphite_parent(){
    local specified_branch="$1"
    gt info --branch=$specified_branch --stat=true | grep "Parent:" | awk '{print $2}'
}




# checkout a branch
gtls() {
    local query="$1"
    local selected_branch
    local cleaned
    local more_cleaned
    selected_branch=$(gt ls | fzf \
        --query="$query" \
        --no-mouse \
        --no-sort  \
        --tac \
        --ansi \
        --border \
        --wrap \
        --ansi \
        --preview-window=up:wrap \
        --bind alt-up:preview-up,alt-down:preview-down \
        --bind 'alt-enter:execute(cleaned=$(echo {} | sed "s/ (needs restack)$//"); branch="${cleaned##* }"; gt pr $branch)' \
        --preview 'cleaned=$(echo {} | sed "s/ (needs restack)$//"); branch="${cleaned##* }"; parent=$(gt info --branch=$branch --stat=true | grep "Parent:" | awk "{print \$2}"); git diff --name-only $parent..$branch')
    if [ -n "$selected_branch" ]; then
        cleaned=$(echo "$selected_branch" | strip_ansi | strip_needs_restack_suffix)
        more_cleaned="${cleaned##* }"
        echo "git checkout $more_cleaned"
        git checkout "$more_cleaned"
    fi
}

gtlss() {
    local query="$1"
    local selected_branch
    local cleaned
    local more_cleaned
    selected_branch=$(gt ls -s | fzf \
        --query="$query" \
        --no-mouse \
        --no-sort  \
        --tac \
        --height 90% \
        --ansi \
        --border \
        --wrap \
        --ansi \
        --preview-window=up:wrap \
        --bind alt-up:preview-up,alt-down:preview-down \
        --bind 'alt-enter:execute(cleaned=$(echo {} | sed "s/ (needs restack)$//"); branch="${cleaned##* }"; gt pr $branch)' \
        --preview 'cleaned=$(echo {} | sed "s/ (needs restack)$//"); branch="${cleaned##* }"; parent=$(gt info --branch=$branch --stat=true | grep "Parent:" | awk "{print \$2}"); git diff --name-only $parent..$branch')
    if [ -n "$selected_branch" ]; then
        cleaned=$(echo "$selected_branch" | strip_ansi | strip_needs_restack_suffix)
        more_cleaned="${cleaned##* }"
        echo "git checkout $more_cleaned"
        git checkout "$more_cleaned"
    fi
}

fzgt(){
    local query="$1"
    local selected_branch
    local cleaned
    local more_cleaned
    selected_branch=$(gt ls | fzf \
        --query="$query" \
        --no-mouse \
        --no-sort  \
        --tac \
        --height 90% \
        --ansi \
        --border \
        --wrap \
        --ansi \
        --preview-window=up:3 \
        --bind alt-up:preview-up,alt-down:preview-down \
        --bind 'alt-enter:execute(cleaned=$(echo {} | sed "s/ (needs restack)$//"); branch="${cleaned##* }"; gt pr $branch)' \
        --preview 'git log --oneline --graph --decorate --color=always --date=short --pretty=format:"%C(auto)%h %ad | %C(reset)%s%C(auto)%d%C(reset)[%an]" {-1}')
    if [ -n "$selected_branch" ]; then
        cleaned=$(echo "$selected_branch" | strip_ansi | strip_needs_restack_suffix)
        more_cleaned="${cleaned##* }"
        echo "gt pr $more_cleaned"
        gt pr "$more_cleaned"
    fi
}



select_modified_file_in_current_pf() {
    local query="$1"
    local selected_filename
    selected_filename=$(git diff --name-only $(gt parent)..HEAD | fzf \
        --query="$query" \
        --no-mouse \
        --no-sort  \
        --tac \
        --ansi \
        --border \
        --wrap \
        --ansi \
        --bind alt-up:preview-up,alt-down:preview-down \
        --preview 'git diff --color=always $(gt parent)..HEAD -- {}')
    if [ -n "$selected_filename" ]; then
        echo "$selected_filename"
    fi
}

# copy a modified file in the current PR
gdpc() {
    # Pass any arguments to select_git_branch as the query.
    local fzf_query="$*"
    local selected_filename
    while true; do
        selected_filename=$(select_modified_file_in_current_pf "$fzf_query")
        if [ -n "$selected_filename" ]; then
            echo "echo $selected_filename | pbcopy"
            echo $selected_filename | pbcopy
        else
            break
        fi
    done
}