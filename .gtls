strip_ansi() {
    sed 's/\x1b\[[0-9;]*m//g'
}

strip_needs_restack_suffix() {
    sed 's/ (needs restack)$//'
}

# alias gdp='git diff --name-only $(gt parent)..HEAD'

gdp(){
    local queried_file="$1"
    if [ -n "$queried_file" ]; then
        git diff $(gt parent)..HEAD -- "$queried_file"
    else
        git diff --name-only $(gt parent)..HEAD
    fi
}

get_graphite_parent(){
    local specified_branch="$1"
    gt info --branch=$specified_branch --stat=true | grep "Parent:" | awk '{print $2}'
}




# checkout a branch
gtls() {
    local query="$1"
    local selected_branch
    local cleaned
    local more_cleaned
    selected_branch=$(gt ls | fzf \
        --query="$query" \
        --no-mouse \
        --no-sort  \
        --tac \
        --ansi \
        --border \
        --wrap \
        --ansi \
        --preview-window=up:wrap \
        --bind alt-up:preview-up,alt-down:preview-down \
        --bind 'alt-enter:execute(cleaned=$(echo {} | sed "s/ (needs restack)$//"); branch="${cleaned##* }"; gt pr $branch)' \
        --preview 'cleaned=$(echo {} | sed "s/ (needs restack)$//"); branch="${cleaned##* }"; parent=$(gt info --branch=$branch --stat=true | grep "Parent:" | awk "{print \$2}"); git diff --name-only $parent..$branch')
    if [ -n "$selected_branch" ]; then
        cleaned=$(echo "$selected_branch" | strip_ansi | strip_needs_restack_suffix)
        more_cleaned="${cleaned##* }"
        echo "git checkout $more_cleaned"
        git checkout "$more_cleaned"
    fi
}

gtlss() {
    local query="$1"
    local selected_branch
    local cleaned
    local more_cleaned
    selected_branch=$(gt ls -s | fzf \
        --query="$query" \
        --no-mouse \
        --no-sort  \
        --tac \
        --height 90% \
        --ansi \
        --border \
        --wrap \
        --ansi \
        --preview-window=up:wrap \
        --bind alt-up:preview-up,alt-down:preview-down \
        --bind 'alt-enter:execute(cleaned=$(echo {} | sed "s/ (needs restack)$//"); branch="${cleaned##* }"; gt pr $branch)' \
        --preview 'cleaned=$(echo {} | sed "s/ (needs restack)$//"); branch="${cleaned##* }"; parent=$(gt info --branch=$branch --stat=true | grep "Parent:" | awk "{print \$2}"); git diff --name-only $parent..$branch')
    if [ -n "$selected_branch" ]; then
        cleaned=$(echo "$selected_branch" | strip_ansi | strip_needs_restack_suffix)
        more_cleaned="${cleaned##* }"
        echo "git checkout $more_cleaned"
        git checkout "$more_cleaned"
    fi
}

fzgt(){
    local query="$1"
    local selected_branch
    local cleaned
    local more_cleaned
    selected_branch=$(gt ls | fzf \
        --query="$query" \
        --no-mouse \
        --no-sort  \
        --tac \
        --height 90% \
        --ansi \
        --border \
        --wrap \
        --ansi \
        --preview-window=up:3 \
        --bind alt-up:preview-up,alt-down:preview-down \
        --bind 'alt-enter:execute(cleaned=$(echo {} | sed "s/ (needs restack)$//"); branch="${cleaned##* }"; gt pr $branch)' \
        --preview 'git log --oneline --graph --decorate --color=always --date=short --pretty=format:"%C(auto)%h %ad | %C(reset)%s%C(auto)%d%C(reset)[%an]" {-1}')
    if [ -n "$selected_branch" ]; then
        cleaned=$(echo "$selected_branch" | strip_ansi | strip_needs_restack_suffix)
        more_cleaned="${cleaned##* }"
        echo "gt pr $more_cleaned"
        gt pr "$more_cleaned"
    fi
}



select_modified_file_in_current_pr() {
    local query="$1"
    local parent
    parent=$(gt parent)
    local selected_filename
    selected_filename=$(git diff --name-only "$parent"..HEAD | fzf \
        --query="$query" \
        --no-mouse \
        --no-sort  \
        --tac \
        --ansi \
        --border \
        --wrap \
        --ansi \
        --bind alt-up:preview-up,alt-down:preview-down \
        --preview "git diff --color=always ${parent}..HEAD -- {}")
    if [ -n "$selected_filename" ]; then
        echo "$selected_filename"
    fi
}

# copy a modified file in the current PR
gdpc() {
    # Pass any arguments to select_git_branch as the query.
    local fzf_query="$*"
    local selected_filename
    while true; do
        selected_filename=$(select_modified_file_in_current_pr "$fzf_query")
        if [ -n "$selected_filename" ]; then
            echo "printf '%s' \"$selected_filename\" | pbcopy"
            printf '%s' "$selected_filename" | pbcopy
        else
            break
        fi
    done
}

# diff a modified file in the current PR (parent vs HEAD) using VS Code
gdpd() {
    local fzf_query="$*"
    local selected_filename
    local base_ref
    base_ref=$(gt parent)
    
    while true; do
        selected_filename=$(select_modified_file_in_current_pr "$fzf_query")
        if [ -n "$selected_filename" ]; then
            local basename=$(basename "$selected_filename")
            local LEFT="/tmp/__parent__${basename}"
            
            cleanup() { rm -f "$LEFT"; }
            trap cleanup EXIT
            
            git show "${base_ref}:${selected_filename}" >"$LEFT" 2>/dev/null || :
            
            echo "code --diff (parent) (HEAD) -- $selected_filename"
            code --diff "$LEFT" "$selected_filename"
        else
            break
        fi
    done
}


fzr(){
    source "$DOTFILES_DIR/.ghi"
    local prs=$(ghi -r)
    local VIEW_PR_USING_CACHE_COMMAND='tempfile="/tmp/fzr_pr_{1}.txt"; if [ ! -f "$tempfile" ]; then (GH_FORCE_TTY=$FZF_PREVIEW_COLUMNS gh pr view {1} > "$tempfile" 2>&1) & fi; count=0; while [ ! -f "$tempfile" ] && [ $count -lt 50 ]; do sleep 0.1; count=$((count + 1)); done; if [ -f "$tempfile" ]; then if command -v bat >/dev/null 2>&1; then bat --color=always --style=plain "$tempfile"; else cat "$tempfile"; fi; else echo "Loading PR #{1}..."; fi'
    local selected=$(echo $prs | \
        fzf --ansi \
            --preview "$VIEW_PR_USING_CACHE_COMMAND" \
            --preview-window='right:60%:wrap' \
            --no-mouse \
            --delimiter=' ' \
            --with-nth=2.. \
            --bind="alt-up:preview-up,alt-down:preview-down,alt-u:preview-page-up,alt-d:preview-page-down,page-down:preview-page-down,page-up:preview-page-up"
    )
    if [ -z "$selected" ]; then
        echo "No PR selected"
        return 1
    fi
    local pr_number=$(echo "$selected" | awk '{print $1}')
    echo "gt pr $pr_number"
    gt pr "$pr_number"
}



fzrc(){
    source "$DOTFILES_DIR/.ghi"
    local prs=$(ghi)
    local VIEW_PR_USING_CACHE_COMMAND='tempfile="/tmp/fzr_pr_{1}.txt"; if [ -f "$tempfile" ]; then if command -v bat >/dev/null 2>&1; then bat --color=always --style=plain "$tempfile"; else cat "$tempfile"; fi; if [ -n "$(find "$tempfile" -mmin +5 2>/dev/null)" ]; then (GH_FORCE_TTY=$FZF_PREVIEW_COLUMNS gh pr view {1} > "$tempfile" 2>&1) & fi; else (GH_FORCE_TTY=$FZF_PREVIEW_COLUMNS gh pr view {1} > "$tempfile" 2>&1) & count=0; while [ ! -f "$tempfile" ] && [ $count -lt 50 ]; do sleep 0.1; count=$((count + 1)); done; if [ -f "$tempfile" ]; then if command -v bat >/dev/null 2>&1; then bat --color=always --style=plain "$tempfile"; else cat "$tempfile"; fi; else echo "Loading PR #{1}..."; fi; fi'
    while true; do
        local selected=$(echo $prs | \
            fzf --ansi \
                --preview "$VIEW_PR_USING_CACHE_COMMAND" \
                --preview-window='right:60%:wrap' \
                --no-mouse \
                --delimiter=' ' \
                --with-nth=2.. \
                --bind="alt-up:preview-up,alt-down:preview-down,alt-u:preview-page-up,alt-d:preview-page-down,page-down:preview-page-down,page-up:preview-page-up"
        )
        if [ -z "$selected" ]; then
            echo "No PR selected"
            return 1
        fi
        local branch=$(echo "$selected" | awk '{print $NF}')
        # echo "gt pr $branch"
        # gt get "$branch"
        local pr_number=$(echo "$selected" | awk '{print $1}')
        echo "gt pr $pr_number"
        gt pr "$pr_number"
    done
}

gdpcode_all(){
    local changed_files=$(git diff --name-only $(gt parent)..HEAD)
    code $(echo $changed_files)
}

gdpcode(){
    # Pass any arguments to select_git_branch as the query.
    local fzf_query="$*"
    local selected_filename
    local changed_files=$(git diff --name-only $(gt parent)..HEAD)
    while true; do
        selected_filename=$(echo $changed_files | fzf \
        --query="$fzf_query" \
        --no-mouse \
        --no-sort  \
        --tac \
        --ansi \
        --border \
        --wrap \
        --ansi \
        --bind alt-up:preview-up,alt-down:preview-down \
        --preview "git diff --color=always -- {}")
        if [ -n "$selected_filename" ]; then
            code $selected_filename
        else
            break
        fi
    done
}

alias gs='git status -s'

gscode_changed_files() {
    {
        git diff --name-only
        git ls-files --others --exclude-standard
    } | sed '/^$/d'
}

gscode_all(){
    local changed_files
    changed_files=$(gscode_changed_files)
    [ -n "$changed_files" ] || return
    code ${(f)changed_files}
}

gscode() {
    # Pass any arguments to select_git_branch as the query.
    local fzf_query="$*"
    local selected_filename
    local changed_files
    changed_files=$(gscode_changed_files)
    while true; do
        selected_filename=$(printf '%s\n' "$changed_files" | fzf \
        --query="$fzf_query" \
        --no-mouse \
        --no-sort  \
        --tac \
        --ansi \
        --border \
        --wrap \
        --ansi \
        --bind alt-up:preview-up,alt-down:preview-down \
        --preview 'if git ls-files --error-unmatch -- {} >/dev/null 2>&1; then git diff --color=always -- {}; elif [ -f {} ]; then if command -v bat >/dev/null 2>&1; then bat --color=always --style=plain -- {}; else cat -- {}; fi; fi')
        if [ -n "$selected_filename" ]; then
            code "$selected_filename"
        else
            break
        fi
    done
}


diffcode(){
    local selected_filename="$1"
    local base_ref
    base_ref=$(gt parent)
    if [ -n "$selected_filename" ]; then
        local basenamed=$(basename "$selected_filename")
        local LEFT="/tmp/__parent__${basenamed}"
        cleanup() { rm -f "$LEFT"; }
        trap cleanup EXIT
        git show "${base_ref}:${selected_filename}" >"$LEFT" 2>/dev/null || :
        code --diff "$LEFT" "$selected_filename"
    else
        break
    fi
}

alias dcode=diffcode
