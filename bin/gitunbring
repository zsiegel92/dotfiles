#!/usr/bin/env bash
# Restore the working tree and index to the current branch.
# Usage: gitunbring
set -euo pipefail

if [[ $# -ne 0 ]]; then
    echo "Usage: gitunbring" >&2
    exit 1
fi

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "gitunbring: not inside a git worktree" >&2
    exit 1
fi

cd "$(git rev-parse --show-toplevel)"

git restore --source HEAD --staged --worktree -- :/
git clean -fd
