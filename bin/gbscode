#!/usr/bin/env bash
# Browse branches with gbs -g; Enter opens that branch's gscode -c <parent>..<branch> view, and leaving gscode returns to the branch picker.
# Usage: gbscode [gbs options] [query]
#
# Starts in the gbs -g tree picker with all of its keys (ctrl-enter switch+stay,
# ctrl-g/f/h/y view switching, ctrl-w, ctrl-b, ctrl-x, ...). Other gbs view flags
# override -g.
#
# Enter on a branch opens `gscode -s -c <parent>..<branch>`, where <parent> is the
# branch's inferred parent (the same one gbs -g and `gparent` use). It starts in
# gscode's side-by-side preview; ctrl-s still toggles to the unified diff. Nothing
# is checked out; it is the same as running that gscode command by hand. Ctrl-C or
# Esc in gscode returns to the picker with the cursor still on that branch.
# Ctrl-C or Esc in the picker exits.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Ctrl-C must not kill this wrapper while gscode is running. A no-op handler (not
# `trap ''`) keeps SIGINT at its default in child processes.
trap : INT

pause() {
  printf '%s\n' "$1" >&2
  read -r -s -n 1 -p "Press any key to return to the branch picker. " _ </dev/tty
  printf '\n' >&2
}

start_args=()
while true; do
  branch=$("$SCRIPT_DIR/select_git_branch" --switch-stay -g "${start_args[@]}" "$@") || exit
  [ -n "$branch" ] || exit
  # Reopen the picker with the cursor on this branch when we come back.
  start_args=(--start-branch "$branch")

  parent=$("$SCRIPT_DIR/gparent" "$branch") || parent=
  if [ -z "$parent" ]; then
    pause "gbscode: no inferred parent for $branch, so there is no range to show"
    continue
  fi

  "$SCRIPT_DIR/gscode" -s -c "$parent..$branch"
done
