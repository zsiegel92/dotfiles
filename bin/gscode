#!/usr/bin/env zsh
# Repeatedly fuzzy-select changed files and open each in VS Code.
# Usage: gscode [-s|--side-by-side] [-b <branch-or-ref> | --branch <branch-or-ref> | -g|--graph|--tree] [query]
#
# Keys in the picker:
#   Enter    open the selected file in VS Code, or enter the interactive hunk pager from the side-by-side preview
#   Ctrl-Enter, or Alt-Enter when fzf cannot bind Ctrl-Enter, opens without leaving fzf
#   Ctrl-H   open the current changeset with `hunk diff`
#   Ctrl-D   open the selected file in `code --diff`
#   Ctrl-P   toggle the preview between the diff and the file's current contents
#   Ctrl-S   toggle the preview between unified and side-by-side hunk views
#   Ctrl-W   toggle filename and file-content search
#   Ctrl-X   copy the selected file path

HELPERS="$(cd "$(dirname "$0")" && pwd)/helpers"
GPARENT="$(cd "$(dirname "$0")" && pwd)/gparent"
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

usage() {
    cat <<'EOF'
gscode - fuzzy-open changed files in VS Code

Usage:
  gscode [-s|--side-by-side] [query]
  gscode [-s|--side-by-side] -b <branch-or-ref> [query]
  gscode [-s|--side-by-side] --branch <branch-or-ref> [query]
  gscode [-s|--side-by-side] --branch=<branch-or-ref> [query]
  gscode [-s|--side-by-side] -g|--graph|--tree [query]
  gscode -h | --help

Examples:
  gscode -b main
  gscode -b HEAD~1
  gscode --branch origin/main zsh
  gscode -g zsh
  gscode -s
  gscode -s -b main zsh

Default mode lists dirty tracked and untracked files.
Branch/ref mode lists files changed in <branch-or-ref>..HEAD.
Graph-parent mode (-g/--graph/--tree) lists files changed in <current branch's parent branch>..HEAD, using the same nearest-parent logic as gbs -g.
Side-by-side mode (-s/--side-by-side) starts in the hunk-oriented side-by-side preview. Ctrl-S and Esc still return to the unified preview.

Keys:
  Enter       open the selected file in VS Code; from the side-by-side preview, open the interactive hunk pager
  Open+stay   Ctrl-Enter, or Alt-Enter when fzf cannot bind Ctrl-Enter
  Ctrl-J/K    decrease/increase the space allocated to the file selector
  Ctrl-H      open the current changeset with hunk diff
  Ctrl-D      open the selected file in code --diff
  Ctrl-P      toggle the preview between the diff and the file's current contents (rendered with bat)
  Ctrl-S      toggle unified and side-by-side hunk previews
  Ctrl-W      toggle filename and file-content search; both filters remain active
  Ctrl-X      copy the selected file path
  Esc         return to the unified preview from side-by-side mode; otherwise exit

Hunk diff view (press Ctrl-H from either preview):
  The sidebar starts open so every changed file is available
  Use Hunk's own review controls
  Ctrl-C        close Hunk and return to the gscode picker

Interactive side-by-side pager (press Enter from the side-by-side preview):
  Up/Down, j/k scroll one line
  Space/b      page forward/backward
  n/N          jump to the next/previous hunk
  g/G          jump to the beginning/end
  q            close the view and return to the fzf picker

Closing either nested view restores the gscode picker. To quit gscode entirely, return to the picker and press Esc.

In default mode, Ctrl-D compares HEAD vs the working tree. In branch/ref mode, Ctrl-D compares the selected ref's version vs the working tree, matching gdpb.
EOF
}

brighten_bat_highlight() {
    # Lift bat's theme-provided highlight background without changing its hue or the syntax foreground colors.
    perl -pe 's/\e\[48;2;(\d+);(\d+);(\d+)/sprintf("\e[48;2;%d;%d;%d", ($1 + 24 > 255 ? 255 : $1 + 24), ($2 + 24 > 255 ? 255 : $2 + 24), ($3 + 24 > 255 ? 255 : $3 + 24))/ge'
}

preview_current_file() {
    local f content_query cols matching_line
    local -a bat_args
    f="$1"
    content_query="$2"
    cols="${FZF_PREVIEW_COLUMNS:-}"
    [ -z "$f" ] && return 0

    if [ ! -f "$f" ]; then
        printf 'File is not present in the working tree: %s\n' "$f"
        return 0
    fi

    if command -v bat >/dev/null 2>&1; then
        bat_args=(--color=always --paging=never --style=plain --wrap=character)
        if [ -n "$cols" ]; then
            bat_args+=(--terminal-width="$cols")
        fi
        if [ -n "$content_query" ] && command -v rg >/dev/null 2>&1; then
            while IFS= read -r matching_line; do
                bat_args+=(--highlight-line "$matching_line")
            done < <(rg --no-filename --text --line-number --fixed-strings --ignore-case -- "$content_query" "$f" | cut -d: -f1)
        fi
        if [ -n "$content_query" ]; then
            bat "${bat_args[@]}" -- "$f" | brighten_bat_highlight
        else
            bat "${bat_args[@]}" -- "$f"
        fi
    else
        cat -- "$f"
    fi
}

preview_file() {
    local base_ref f content_query
    base_ref="$1"
    f="$2"
    content_query="$3"
    [ -z "$f" ] && return 0

    if [ -n "$base_ref" ]; then
        git diff --color=always "$base_ref"..HEAD -- "$f" | preview_unified_diff
    elif git ls-files --error-unmatch -- "$f" >/dev/null 2>&1; then
        git diff --color=always -- "$f" | preview_unified_diff
    else
        preview_current_file "$f" "$content_query"
    fi
}

changed_files_for_mode() {
    local base_ref="$1"

    if [ -n "$base_ref" ]; then
        git diff --name-only "$base_ref"..HEAD | "$HELPERS/git_paths_relative_to_cwd" | sed '/^$/d'
    else
        "$HELPERS/gscode_changed_files"
    fi
}

content_filter_changed_files() {
    local base_ref="$1" content_query="$2" file_path

    if [ -z "$content_query" ]; then
        changed_files_for_mode "$base_ref"
        return
    fi

    changed_files_for_mode "$base_ref" | while IFS= read -r file_path; do
        [ -f "$file_path" ] || continue
        grep -F -i -q -- "$content_query" "$file_path" && print -r -- "$file_path"
    done
}

filter_changed_files() {
    local base_ref="$1" filename_query="$2" content_query="$3"

    if [ -z "$filename_query" ]; then
        content_filter_changed_files "$base_ref" "$content_query"
    else
        content_filter_changed_files "$base_ref" "$content_query" | fzf --filter="$filename_query" --no-sort
    fi
}

# fzf pages through preview output by physical lines. When fzf wraps a long
# source line itself, a page action can therefore skip text that was only
# visible on wrapped display rows. Have bat wrap the diff to the exact preview
# width first so each display row is a real output line.
preview_unified_diff() {
    if command -v bat >/dev/null 2>&1 && [ -n "$FZF_PREVIEW_COLUMNS" ]; then
        bat --color=always --language=diff --paging=never --style=plain --wrap=character --terminal-width="$FZF_PREVIEW_COLUMNS" -- -
    else
        cat
    fi
}

preview_file_side_by_side() {
    local base_ref f cols
    base_ref="$1"
    f="$2"
    [ -z "$f" ] && return 0

    if ! command -v delta >/dev/null 2>&1; then
        echo "Side-by-side preview requires delta (https://github.com/dandavison/delta)." >&2
        return 1
    fi

    cols="${FZF_PREVIEW_COLUMNS:-}"
    if [ -z "$cols" ] || [ "$cols" -lt 40 ]; then
        cols=200
    fi

    if [ -n "$base_ref" ]; then
        git diff --color=always "$base_ref"..HEAD -- "$f" | delta --side-by-side --line-numbers --width "$cols" --paging=never
    elif git ls-files --error-unmatch -- "$f" >/dev/null 2>&1; then
        git diff --color=always -- "$f" | delta --side-by-side --line-numbers --width "$cols" --paging=never
    elif [ -f "$f" ]; then
        if command -v bat >/dev/null 2>&1; then
            bat --color=always --style=numbers --terminal-width="$cols" -- "$f"
        else
            cat -- "$f"
        fi
    fi
}

page_file_side_by_side() {
    local base_ref f cols hunk_pager_legend hunk_pager file_pager_legend file_pager
    base_ref="$1"
    f="$2"
    [ -z "$f" ] && return 0

    if ! command -v delta >/dev/null 2>&1; then
        echo "Interactive hunk navigation requires delta (https://github.com/dandavison/delta)." >&2
        return 1
    fi

    cols=$(stty size < /dev/tty 2>/dev/null | awk '{print $2}')
    if [ -z "$cols" ] || [ "$cols" -lt 40 ]; then
        cols=$(tput cols 2>/dev/null)
    fi
    [ -z "$cols" ] && cols=200
    export COLUMNS="$cols"

    if [ "$cols" -ge 76 ]; then
        hunk_pager_legend='↑↓/jk scroll · Space/b page · n/N hunks · g/G ends · q back; then Esc quit'
        file_pager_legend='↑↓/jk scroll · Space/b page · g/G ends · q back; then Esc quit'
    elif [ "$cols" -ge 60 ]; then
        hunk_pager_legend='↑↓/jk scroll · Sp/b page · n/N hunk · g/G ends · q→Esc quit'
        file_pager_legend='↑↓/jk scroll · Sp/b page · g/G ends · q→Esc quit'
    elif [ "$cols" -ge 44 ]; then
        hunk_pager_legend='↑↓/jk scroll · n/N hunk · q→Esc quit'
        file_pager_legend='↑↓/jk scroll · Sp/b page · q→Esc quit'
    elif [ "$cols" -ge 24 ]; then
        hunk_pager_legend='jk scroll · q→Esc quit'
        file_pager_legend="$hunk_pager_legend"
    else
        hunk_pager_legend='q→Esc quit'
        file_pager_legend="$hunk_pager_legend"
    fi
    hunk_pager="less -R -Ps'$hunk_pager_legend' -Pm'$hunk_pager_legend' -PM'$hunk_pager_legend'"
    file_pager="less -R -Ps'$file_pager_legend' -Pm'$file_pager_legend' -PM'$file_pager_legend'"

    if [ -n "$base_ref" ]; then
        git diff --color=always "$base_ref"..HEAD -- "$f" | delta --side-by-side --line-numbers --width "$cols" --navigate --paging=always --pager "$hunk_pager"
    elif git ls-files --error-unmatch -- "$f" >/dev/null 2>&1; then
        git diff --color=always -- "$f" | delta --side-by-side --line-numbers --width "$cols" --navigate --paging=always --pager "$hunk_pager"
    elif [ -f "$f" ]; then
        if command -v bat >/dev/null 2>&1; then
            bat --color=always --paging=always --pager "$file_pager" --style=numbers --terminal-width="$cols" -- "$f"
        else
            less -R "-Ps$file_pager_legend" "-Pm$file_pager_legend" "-PM$file_pager_legend" -- "$f"
        fi
    fi
}

open_hunk_diff() {
    local base_ref
    local -a hunk_command
    base_ref="$1"

    if ! command -v hunk >/dev/null 2>&1; then
        echo "Hunk diff view requires hunk (https://github.com/modem-dev/hunk)." >&2
        return 1
    fi

    hunk_command=(hunk diff)
    if [ -n "$base_ref" ]; then
        hunk_command+=("$base_ref")
    fi

    # Hunk's Bun runtime needs a fresh pseudo-terminal inside an fzf execute()
    # child. The Expect launcher also waits for Hunk to be ready and presses
    # its supported `s` shortcut once so the responsive sidebar starts open.
    if command -v expect >/dev/null 2>&1; then
        expect "$HELPERS/gscode_hunk_viewer.exp" "${hunk_command[@]:1}" < /dev/tty > /dev/tty 2>&1
    elif [ "$(uname -s)" = "Darwin" ] && command -v script >/dev/null 2>&1; then
        script -q /dev/null "${hunk_command[@]}" < /dev/tty > /dev/tty 2>&1
    else
        "${hunk_command[@]}" < /dev/tty > /dev/tty 2>&1
    fi
}

enter_preview_action() {
    local base_ref="$1" f="$2" quoted_self quoted_f pager_command

    if [ "$FZF_PREVIEW_LABEL" != "side-by-side hunks" ]; then
        print -r -- accept
        return
    fi

    quoted_self=${(q)SELF}
    quoted_f=${(q)f}
    if [ -n "$base_ref" ]; then
        local quoted_base_ref=${(q)base_ref}
        pager_command="$quoted_self --page-side-by-side --branch $quoted_base_ref $quoted_f"
    else
        pager_command="$quoted_self --page-side-by-side $quoted_f"
    fi
    print -r -- "execute[$pager_command]"
}

preview_content_query_arg() {
    if [ "$1" = "--live-content-query" ]; then
        print -r -- '{q}'
    else
        print -r -- ${(q)2}
    fi
}

preview_toggle_actions() {
    local base_ref="$1" header="$2" fallback_file_count="$3" query_option="$4" content_query="$5"
    local quoted_self quoted_header quoted_content_query unified_preview side_by_side_preview preview_window
    quoted_self=${(q)SELF}
    quoted_header=${(q)header}
    quoted_content_query=$(preview_content_query_arg "$query_option" "$content_query") || return

    if [ -n "$base_ref" ]; then
        local quoted_base_ref=${(q)base_ref}
        unified_preview="$quoted_self --preview-file --branch $quoted_base_ref --content-query $quoted_content_query {}"
        side_by_side_preview="$quoted_self --preview-side-by-side --branch $quoted_base_ref {}"
    else
        unified_preview="$quoted_self --preview-file --content-query $quoted_content_query {}"
        side_by_side_preview="$quoted_self --preview-side-by-side {}"
    fi

    if [ "$FZF_PREVIEW_LABEL" = "side-by-side hunks" ]; then
        preview_window=$(unified_preview_window "$fallback_file_count") || return
        print -r -- "change-preview-window[$preview_window]+change-preview[$unified_preview]+change-preview-label[unified diff]+transform-header[$quoted_self --fzf-header right $quoted_header]"
    else
        preview_window=$(stacked_preview_window "$header" "$fallback_file_count") || return
        print -r -- "change-preview-window[$preview_window]+change-preview[$side_by_side_preview]+change-preview-label[side-by-side hunks]+transform-header[$quoted_self --fzf-header stacked $quoted_header]"
    fi
}

current_file_toggle_actions() {
    local base_ref="$1" header="$2" fallback_file_count="$3" query_option="$4" content_query="$5"
    local quoted_self quoted_header quoted_content_query unified_preview current_file_preview preview_window
    quoted_self=${(q)SELF}
    quoted_header=${(q)header}
    quoted_content_query=$(preview_content_query_arg "$query_option" "$content_query") || return

    if [ -n "$base_ref" ]; then
        local quoted_base_ref=${(q)base_ref}
        unified_preview="$quoted_self --preview-file --branch $quoted_base_ref --content-query $quoted_content_query {}"
    else
        unified_preview="$quoted_self --preview-file --content-query $quoted_content_query {}"
    fi
    current_file_preview="$quoted_self --preview-current-file --content-query $quoted_content_query {}"

    if [ "$FZF_PREVIEW_LABEL" = "current file" ]; then
        preview_window=$(unified_preview_window "$fallback_file_count") || return
        print -r -- "change-preview-window[$preview_window]+change-preview[$unified_preview]+change-preview-label[unified diff]+transform-header[$quoted_self --fzf-header right $quoted_header]"
    else
        preview_window=$(unified_preview_window "$fallback_file_count") || return
        print -r -- "change-preview-window[$preview_window]+change-preview[$current_file_preview]+change-preview-label[current file]+transform-header[$quoted_self --fzf-header right $quoted_header]"
    fi
}

fzf_header() {
    local layout="$1" header="$2" width_percent full_width_below

    if [ "$layout" = "current" ]; then
        if [ "$FZF_PREVIEW_LABEL" = "side-by-side hunks" ]; then
            layout=stacked
        else
            layout=right
        fi
    fi

    case "$layout" in
        right)
            width_percent=50
            # The preview's <100(...) fallback is based on the width of the 50% preview pane, so it switches to the stacked layout below 200 terminal columns.
            full_width_below=200
            ;;
        stacked)
            width_percent=100
            full_width_below=0
            ;;
        *)
            echo "gscode: invalid fzf header layout: $layout" >&2
            return 2
            ;;
    esac

    "$HELPERS/fzf_wrap_header" --width-percent "$width_percent" --full-width-below "$full_width_below" "$header"
}

stacked_preview_window() {
    local header="$1" fallback_file_count="$2"
    local total_lines file_count header_lines selector_lines max_selector_lines preview_lines

    total_lines="${FZF_LINES:-$(tput lines 2>/dev/null)}"
    case "$total_lines" in
        ''|*[!0-9]*) total_lines=40 ;;
    esac

    file_count="${FZF_MATCH_COUNT:-$fallback_file_count}"
    case "$file_count" in
        ''|*[!0-9]*) file_count=0 ;;
    esac

    header_lines=$(fzf_header stacked "$header" | awk 'END { print NR }')
    [ -z "$header_lines" ] && header_lines=1

    # In addition to the matches and wrapped header, leave room for fzf's
    # prompt, separators, and border. Keep at least half of the terminal for
    # the scrollable diff preview.
    selector_lines=$((file_count + header_lines + 4))
    max_selector_lines=$((total_lines / 2))
    [ "$max_selector_lines" -lt 1 ] && max_selector_lines=1
    [ "$selector_lines" -gt "$max_selector_lines" ] && selector_lines="$max_selector_lines"
    preview_lines=$((total_lines - selector_lines))
    [ "$preview_lines" -lt 1 ] && preview_lines=1

    # Explicitly replace the narrow-width fallback too. change-preview-window
    # otherwise inherits the unified view's fixed 70% fallback when Ctrl-S
    # switches into this layout.
    print -r -- "down,${preview_lines},border-top,nowrap,<100(down,${preview_lines},border-top,nowrap)"
}

unified_preview_window() {
    local fallback_file_count="$1"
    local total_lines file_count additional_file_percent selector_percent preview_percent

    total_lines="${FZF_LINES:-$(tput lines 2>/dev/null)}"
    case "$total_lines" in
        ''|*[!0-9]*) total_lines=40 ;;
    esac
    [ "$total_lines" -lt 1 ] && total_lines=40

    file_count="${FZF_MATCH_COUNT:-$fallback_file_count}"
    case "$file_count" in
        ''|*[!0-9]*) file_count=0 ;;
    esac

    # fzf itself preserves the space required by the prompt and wrapped
    # header. Reserve 15% for one result, add one row per additional result,
    # and never let the selector consume more than half of the terminal.
    selector_percent=15
    if [ "$file_count" -gt 1 ]; then
        additional_file_percent=$((((file_count - 1) * 100 + total_lines - 1) / total_lines))
        selector_percent=$((selector_percent + additional_file_percent))
    fi
    [ "$selector_percent" -gt 50 ] && selector_percent=50
    preview_percent=$((100 - selector_percent))

    print -r -- "right,50%,border-left,wrap,<100(down,${preview_percent}%,border-top,wrap)"
}

fit_preview_action() {
    local header="$1" fallback_file_count="$2" preview_window preview_lines

    if [ "$FZF_PREVIEW_LABEL" != "side-by-side hunks" ]; then
        preview_window=$(unified_preview_window "$fallback_file_count") || return
        print -r -- "change-preview-window[$preview_window]"
        return 0
    fi

    preview_window=$(stacked_preview_window "$header" "$fallback_file_count") || return
    preview_lines="${preview_window#down,}"
    preview_lines="${preview_lines%%,*}"
    if [ -n "${FZF_PREVIEW_LINES:-}" ] && [ "$FZF_PREVIEW_LINES" = "$preview_lines" ]; then
        return 0
    fi
    print -r -- "change-preview-window[$preview_window]"
}

adjust_selector_action() {
    local direction="$1"
    local total_size selector_size preview_size step min_selector_size min_preview_size orientation border wrap fallback

    case "$direction" in
        decrease|increase) ;;
        *) return 2 ;;
    esac

    case "${FZF_PREVIEW_LEFT:-}" in
        ''|*[!0-9]*) return 0 ;;
    esac
    case "${FZF_PREVIEW_TOP:-}" in
        ''|*[!0-9]*) return 0 ;;
    esac
    case "${FZF_PREVIEW_COLUMNS:-}" in
        ''|*[!0-9]*) return 0 ;;
    esac
    case "${FZF_PREVIEW_LINES:-}" in
        ''|*[!0-9]*) return 0 ;;
    esac
    case "${FZF_COLUMNS:-}" in
        ''|*[!0-9]*) return 0 ;;
    esac

    if [ $((FZF_PREVIEW_COLUMNS * 4)) -lt $((FZF_COLUMNS * 3)) ]; then
        total_size="${FZF_COLUMNS:-}"
        selector_size=$((total_size - FZF_PREVIEW_COLUMNS))
        min_selector_size=5
        min_preview_size=20
        orientation=right
        border=border-left
        wrap=wrap
    else
        total_size="${FZF_LINES:-}"
        selector_size=$((total_size - FZF_PREVIEW_LINES))
        min_selector_size=1
        min_preview_size=5
        orientation=down
        border=border-top
        if [ "$FZF_PREVIEW_LABEL" = "side-by-side hunks" ]; then
            wrap=nowrap
        else
            wrap=wrap
        fi
    fi

    case "$total_size" in
        ''|*[!0-9]*) return 0 ;;
    esac
    [ "$total_size" -gt $((min_selector_size + min_preview_size)) ] || return 0

    step=$((total_size / 20))
    [ "$step" -lt 1 ] && step=1
    if [ "$direction" = decrease ]; then
        selector_size=$((selector_size - step))
    else
        selector_size=$((selector_size + step))
    fi
    [ "$selector_size" -lt "$min_selector_size" ] && selector_size="$min_selector_size"
    [ "$selector_size" -gt $((total_size - min_preview_size)) ] && selector_size=$((total_size - min_preview_size))
    preview_size=$((total_size - selector_size))

    if [ "$orientation" = right ]; then
        fallback="<100(down,70%,border-top,$wrap)"
    else
        fallback="<100(down,$preview_size,border-top,$wrap)"
    fi
    print -r -- "change-preview-window[$orientation,$preview_size,$border,$wrap,$fallback]"
}

open_diff_file() {
    local base_ref f repo_path basename LEFT
    base_ref="$1"
    f="$2"
    [ -z "$f" ] && return 0

    if [ -n "$base_ref" ]; then
        repo_path=$(git ls-files --full-name -- "$f" 2>/dev/null | sed -n '1p')
        [ -z "$repo_path" ] && repo_path="$f"
        basename=$(basename "$f")
        LEFT="/tmp/__base__${basename}"
        git show "${base_ref}:${repo_path}" >"$LEFT" 2>/dev/null || : >"$LEFT"
        code --diff "$LEFT" "$f"
    elif git ls-files --error-unmatch -- "$f" >/dev/null 2>&1; then
        repo_path=$(git ls-files --full-name --error-unmatch -- "$f" 2>/dev/null | sed -n '1p')
        basename=$(basename "$f")
        LEFT="/tmp/__head__${basename}"
        git show "HEAD:$repo_path" >"$LEFT" 2>/dev/null || : >"$LEFT"
        code --diff "$LEFT" "$f"
    else
        code "$f"
    fi
}

# Internal: invoked by the fzf ctrl-x binding.
if [ "$1" = "--copy-file" ]; then
    shift
    [ -n "$1" ] && printf '%s' "$1" | pbcopy
    exit 0
fi

# Internal: invoked by the fzf open+stay binding.
if [ "$1" = "--open-file" ]; then
    shift
    [ -n "$1" ] && code "$1"
    exit 0
fi

# Internal: invoked by the fzf preview binding.
if [ "$1" = "--preview-file" ]; then
    shift
    base_ref=
    content_query=
    if [ "$1" = "--branch" ]; then
        base_ref="$2"
        shift 2
    fi
    if [ "$1" = "--content-query" ]; then
        content_query="$2"
        shift 2
    fi
    preview_file "$base_ref" "$1" "$content_query"
    exit 0
fi

# Internal: invoked by the fzf current-file preview binding.
if [ "$1" = "--preview-current-file" ]; then
    shift
    content_query=
    if [ "$1" = "--content-query" ]; then
        content_query="$2"
        shift 2
    fi
    preview_current_file "$1" "$content_query"
    exit 0
fi

# Internal: list files matching both the filename and content filters. The
# content-query picker reloads this command whenever its query changes.
if [ "$1" = "--filter-files" ]; then
    shift
    base_ref=
    if [ "$1" = "--branch" ]; then
        base_ref="$2"
        shift 2
    fi
    filter_changed_files "$base_ref" "$1" "$2"
    exit $?
fi

# Internal: preserve the active preview mode when Ctrl-W restarts fzf to switch query modes.
if [ "$1" = "--toggle-query-mode" ]; then
    shift
    case "$FZF_PREVIEW_LABEL" in
        "unified diff"|"side-by-side hunks"|"current file")
            preview_label="$FZF_PREVIEW_LABEL"
            ;;
        *)
            preview_label="unified diff"
            ;;
    esac
    print -r -- "print[$1]+print[$preview_label]+accept"
    exit 0
fi

# Internal: invoked when fzf needs to rewrap its header.
if [ "$1" = "--fzf-header" ]; then
    shift
    fzf_header "$1" "$2"
    exit $?
fi

# Internal: invoked by fzf preview and nested-view bindings.
if [ "$1" = "--preview-side-by-side" ] || [ "$1" = "--page-side-by-side" ] || [ "$1" = "--hunk-diff" ] || [ "$1" = "--toggle-preview" ] || [ "$1" = "--toggle-current-file" ] || [ "$1" = "--escape-preview" ] || [ "$1" = "--enter-preview" ] || [ "$1" = "--fit-preview" ] || [ "$1" = "--adjust-selector" ]; then
    internal_action="$1"
    shift
    base_ref=
    if [ "$1" = "--branch" ]; then
        base_ref="$2"
        shift 2
    fi

    case "$internal_action" in
        --preview-side-by-side)
            preview_file_side_by_side "$base_ref" "$1"
            ;;
        --page-side-by-side)
            page_file_side_by_side "$base_ref" "$1"
            ;;
        --hunk-diff)
            open_hunk_diff "$base_ref"
            ;;
        --toggle-preview)
            preview_toggle_actions "$base_ref" "$1" "$2" "$3" "$4"
            ;;
        --toggle-current-file)
            current_file_toggle_actions "$base_ref" "$1" "$2" "$3" "$4"
            ;;
        --escape-preview)
            if [ "$FZF_PREVIEW_LABEL" = "side-by-side hunks" ]; then
                preview_toggle_actions "$base_ref" "$1" "$2" "$3" "$4"
            else
                print -r -- abort
            fi
            ;;
        --enter-preview)
            enter_preview_action "$base_ref" "$1"
            ;;
        --fit-preview)
            fit_preview_action "$1" "$2"
            ;;
        --adjust-selector)
            adjust_selector_action "$1"
            ;;
    esac
    exit 0
fi

# Internal: invoked by the fzf ctrl-d binding.
if [ "$1" = "--diff-file" ]; then
    shift
    base_ref=
    if [ "$1" = "--branch" ]; then
        base_ref="$2"
        shift 2
    fi
    open_diff_file "$base_ref" "$1"
    exit 0
fi

base_ref=
graph_parent_mode=0
start_side_by_side=0
fzf_query_parts=()
while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -b|--branch)
            shift
            if [ -z "$1" ]; then
                echo "gscode: -b/--branch requires a branch or ref" >&2
                exit 2
            fi
            base_ref="$1"
            ;;
        --branch=*)
            base_ref="${1#--branch=}"
            if [ -z "$base_ref" ]; then
                echo "gscode: --branch requires a non-empty branch or ref" >&2
                exit 2
            fi
            ;;
        -g|--graph|--tree)
            graph_parent_mode=1
            ;;
        -s|--side-by-side)
            start_side_by_side=1
            ;;
        --)
            shift
            fzf_query_parts+=("$@")
            break
            ;;
        *)
            fzf_query_parts+=("$1")
            ;;
    esac
    shift
done

fzf_query="${(j: :)fzf_query_parts}"
quoted_self=${(q)SELF}

if [ "$graph_parent_mode" -eq 1 ]; then
    if [ -n "$base_ref" ]; then
        echo "gscode: choose either -g/--graph/--tree or -b/--branch, not both" >&2
        exit 2
    fi

    current_branch=$(git branch --show-current)
    if [ -z "$current_branch" ]; then
        echo "gscode: -g requires being on a local branch" >&2
        exit 1
    fi

    base_ref=$("$GPARENT" "$current_branch") || exit
    if [ -z "$base_ref" ]; then
        echo "gscode: no parent branch found for $current_branch" >&2
        exit 1
    fi
fi

if printf 'x\n' | fzf --filter x --bind 'ctrl-enter:execute-silent(true)' >/dev/null 2>&1; then
    open_stay_key_label="ctrl-enter"
    open_stay_keys=(ctrl-enter)
else
    open_stay_key_label="alt-enter"
    open_stay_keys=(alt-enter)
fi

open_stay_bind=
for key in "${open_stay_keys[@]}"; do
    [ -n "$open_stay_bind" ] && open_stay_bind+=","
    open_stay_bind+="${key}:execute-silent($quoted_self --open-file {})"
done

if [ -n "$base_ref" ]; then
    if ! git rev-parse --verify --quiet "${base_ref}^{commit}" >/dev/null; then
        echo "gscode: branch/ref not found: $base_ref" >&2
        exit 1
    fi
    quoted_base_ref=${(q)base_ref}
    header_base="enter: code · ctrl-h: Hunk changeset (Ctrl-C returns) · $open_stay_key_label: open+stay · ctrl-d: code --diff ($base_ref vs working) · ctrl-p: current file · ctrl-s: toggle side-by-side · ctrl-x: copy path · ctrl-j/k: selector −/+"
    diff_bind="ctrl-d:execute($quoted_self --diff-file --branch $quoted_base_ref {})"
    hunk_bind="ctrl-h:execute($quoted_self --hunk-diff --branch $quoted_base_ref)"
    preview_enter_cmd="$quoted_self --enter-preview --branch $quoted_base_ref {}"
else
    header_base="enter: code · ctrl-h: Hunk changeset (Ctrl-C returns) · $open_stay_key_label: open+stay · ctrl-d: code --diff (HEAD vs working) · ctrl-p: current file · ctrl-s: toggle side-by-side · ctrl-x: copy path · ctrl-j/k: selector −/+"
    diff_bind="ctrl-d:execute($quoted_self --diff-file {})"
    hunk_bind="ctrl-h:execute($quoted_self --hunk-diff)"
    preview_enter_cmd="$quoted_self --enter-preview {}"
fi

changed_files=$(changed_files_for_mode "$base_ref")
if [ -n "$changed_files" ]; then
    file_count=$(printf '%s\n' "$changed_files" | awk 'END { print NR }')
else
    file_count=0
fi
filename_query="$fzf_query"
content_query=""
query_mode=filename
query_toggle_marker="__gscode_toggle_content_search__"
picker_query=""
if [ "$start_side_by_side" -eq 1 ]; then
    picker_preview_label="side-by-side hunks"
else
    picker_preview_label="unified diff"
fi

parse_picker_output() {
    local picker_output="$1" second_line third_line selected_line

    picker_query=$(printf '%s\n' "$picker_output" | sed -n '1p')
    second_line=$(printf '%s\n' "$picker_output" | sed -n '2p')
    third_line=$(printf '%s\n' "$picker_output" | sed -n '3p')

    if [ "$second_line" = "$query_toggle_marker" ]; then
        case "$third_line" in
            "unified diff"|"side-by-side hunks"|"current file")
                picker_preview_label="$third_line"
                ;;
            *)
                picker_preview_label="unified diff"
                ;;
        esac
        return 2
    fi

    if [ -n "$third_line" ] || [ -z "$second_line" ]; then
        selected_line="$third_line"
    else
        selected_line="$second_line"
    fi

    [ -n "$selected_line" ] || return 1
    selected_filename="$selected_line"
}

run_picker() {
    local picker_header rendered_header active_query prompt picker_output picker_status parse_status
    local quoted_header quoted_content_query preview_query_arg preview_action_query_args preview_toggle_cmd current_file_toggle_cmd preview_escape_cmd fit_preview_cmd adjust_selector_cmd query_mode_toggle_cmd
    local unified_preview_cmd side_by_side_preview_cmd current_file_preview_cmd preview_cmd preview_label preview_window header_layout content_filter_cmd quoted_filename_query
    local -a picker_args

    if [ "$query_mode" = "content" ]; then
        picker_header="$header_base · ctrl-w: search filenames"
        active_query="$content_query"
        prompt='contents> '
    else
        picker_header="$header_base · ctrl-w: search contents"
        active_query="$filename_query"
        prompt='files> '
    fi
    quoted_header=${(q)picker_header}
    if [ "$query_mode" = "content" ]; then
        preview_query_arg='{q}'
        preview_action_query_args='--live-content-query'
    else
        quoted_content_query=${(q)content_query}
        preview_query_arg="$quoted_content_query"
        preview_action_query_args="--content-query $quoted_content_query"
    fi

    if [ -n "$base_ref" ]; then
        unified_preview_cmd="$quoted_self --preview-file --branch $quoted_base_ref --content-query $preview_query_arg {}"
        side_by_side_preview_cmd="$quoted_self --preview-side-by-side --branch $quoted_base_ref {}"
        preview_toggle_cmd="$quoted_self --toggle-preview --branch $quoted_base_ref $quoted_header $file_count $preview_action_query_args"
        current_file_toggle_cmd="$quoted_self --toggle-current-file --branch $quoted_base_ref $quoted_header $file_count $preview_action_query_args"
        preview_escape_cmd="$quoted_self --escape-preview --branch $quoted_base_ref $quoted_header $file_count $preview_action_query_args"
    else
        unified_preview_cmd="$quoted_self --preview-file --content-query $preview_query_arg {}"
        side_by_side_preview_cmd="$quoted_self --preview-side-by-side {}"
        preview_toggle_cmd="$quoted_self --toggle-preview $quoted_header $file_count $preview_action_query_args"
        current_file_toggle_cmd="$quoted_self --toggle-current-file $quoted_header $file_count $preview_action_query_args"
        preview_escape_cmd="$quoted_self --escape-preview $quoted_header $file_count $preview_action_query_args"
    fi
    current_file_preview_cmd="$quoted_self --preview-current-file --content-query $preview_query_arg {}"
    fit_preview_cmd="$quoted_self --fit-preview $quoted_header $file_count"
    adjust_selector_cmd="$quoted_self --adjust-selector"
    query_mode_toggle_cmd="$quoted_self --toggle-query-mode ${(q)query_toggle_marker}"

    case "$picker_preview_label" in
        "side-by-side hunks")
            preview_cmd="$side_by_side_preview_cmd"
            preview_label="side-by-side hunks"
            preview_window=$(stacked_preview_window "$picker_header" "$file_count") || return
            header_layout=stacked
            ;;
        "current file")
            preview_cmd="$current_file_preview_cmd"
            preview_label="current file"
            preview_window=$(unified_preview_window "$file_count") || return
            header_layout=right
            ;;
        *)
            preview_cmd="$unified_preview_cmd"
            preview_label="unified diff"
            preview_window=$(unified_preview_window "$file_count") || return
            header_layout=right
            ;;
    esac
    rendered_header=$(fzf_header "$header_layout" "$picker_header") || return

    picker_args=(
        --query="$active_query"
        --print-query
        --no-clear
        --no-mouse
        --no-sort
        --tac
        --ansi
        --border
        --wrap
        --prompt "$prompt"
        --header "$rendered_header"
        --preview-label "$preview_label"
        --preview-window "$preview_window"
        --bind "result:transform($fit_preview_cmd)"
        --bind "alt-up:preview-up,alt-down:preview-down,alt-u:preview-page-up,alt-d:preview-page-down,page-up:preview-page-up,page-down:preview-page-down"
        --bind "$open_stay_bind"
        --bind "$diff_bind"
        --bind "$hunk_bind"
        --bind "ctrl-x:execute-silent($quoted_self --copy-file {})"
        --bind "ctrl-p:transform($current_file_toggle_cmd)"
        --bind "ctrl-s:transform($preview_toggle_cmd)+transform($fit_preview_cmd)"
        --bind "ctrl-w:transform($query_mode_toggle_cmd)"
        --bind "esc:transform($preview_escape_cmd)"
        --bind "enter:transform($preview_enter_cmd)"
        --bind "ctrl-j:transform($adjust_selector_cmd decrease),ctrl-k:transform($adjust_selector_cmd increase)"
        --preview "$preview_cmd"
    )

    if [ "$query_mode" = "content" ]; then
        quoted_filename_query=${(q)filename_query}
        if [ -n "$base_ref" ]; then
            content_filter_cmd="$quoted_self --filter-files --branch $quoted_base_ref $quoted_filename_query"
        else
            content_filter_cmd="$quoted_self --filter-files $quoted_filename_query"
        fi
        picker_output=$(filter_changed_files "$base_ref" "$filename_query" "$content_query" | fzf --disabled "${picker_args[@]}" --bind "change:reload($content_filter_cmd {q})")
    else
        picker_output=$(content_filter_changed_files "$base_ref" "$content_query" | fzf "${picker_args[@]}")
    fi
    picker_status=$?

    parse_picker_output "$picker_output"
    parse_status=$?
    if [ "$parse_status" -eq 0 ] || [ "$parse_status" -eq 2 ]; then
        return "$parse_status"
    fi
    [ "$picker_status" -eq 0 ] && return "$parse_status"
    return "$picker_status"
}

# Ctrl-W restarts fzf to swap its active query without discarding the other query. Keep the alternate screen open across those short-lived picker processes to avoid flashing back to the shell between them.
restore_terminal_screen() {
    tput rmcup > /dev/tty 2>/dev/null || true
}
trap restore_terminal_screen EXIT

# Do not run transforms or preview commands from fzf's resize event. A fast
# terminal drag can queue those actions and block keyboard input indefinitely.
while true; do
    run_picker
    picker_status=$?

    case "$picker_status" in
        0)
            code "$selected_filename"
            ;;
        2)
            if [ "$query_mode" = "content" ]; then
                content_query="$picker_query"
                query_mode=filename
            else
                filename_query="$picker_query"
                query_mode=content
            fi
            ;;
        *)
            break
            ;;
    esac
done
