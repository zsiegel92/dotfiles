#!/usr/bin/env bash
# Convert GitHub-flavored Markdown to a styled standalone HTML document.

set -euo pipefail

if (( $# < 1 || $# > 2 )); then
    echo "Usage: md-to-html <input.md> [output.html]" >&2
    exit 2
fi

if ! command -v pandoc >/dev/null 2>&1; then
    echo "error: pandoc is required (install it with: brew install pandoc)" >&2
    exit 1
fi

input_path="$1"
if [[ ! -f "${input_path}" ]]; then
    echo "error: input file does not exist: ${input_path}" >&2
    exit 1
fi

input_basename="$(basename -- "${input_path}")"
output_basename="${input_basename%.*}.html"
if (( $# == 2 )); then
    if [[ -d "$2" ]]; then
        output_path="${2}/${output_basename}"
    else
        output_path="$2"
    fi
else
    output_path="$(dirname -- "${input_path}")/${output_basename}"
fi

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
assets_dir="${script_dir}/md-to-html-assets"
document_title="${input_basename%.*}"

pandoc \
    --from=gfm \
    --to=html5 \
    --standalone \
    --embed-resources \
    --toc \
    --toc-depth=3 \
    --section-divs \
    --syntax-highlighting=monochrome \
    --metadata=pagetitle:"${document_title}" \
    --css="${assets_dir}/style.css" \
    --include-in-header="${assets_dir}/mermaid.html" \
    --lua-filter="${assets_dir}/mermaid.lua" \
    --output="${output_path}" \
    "${input_path}"

echo "${output_path}"
