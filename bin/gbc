#!/usr/bin/env bash
# Fuzzy-select a branch and copy its name to the clipboard.
# Usage: gbc [-g|--graph|--tree|-f|--full-dag|-h|--handmade-dag] [-a|--all-ancestry] [query]
branch=$(select_git_branch "$@")
if [ -n "$branch" ]; then
    echo "printf '%s' \"$branch\" | pbcopy"
    printf '%s' "$branch" | pbcopy
fi
