#!/usr/bin/env bash
# flm (fuzzy list modified): fuzzy-select a file (newest-modified first) under a
# directory and open it in VS Code.
# Usage: flm [-d depth] [-f] [dir=.]
#   -d depth  limit recursion to <depth> directory levels (default: infinite)
#   -f        only files in the immediate directory (equivalent to -d 1)
HELPERS="$(cd "$(dirname "$0")" && pwd)/helpers"
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

if [ "$1" = "--open-file" ]; then
  shift
  [ -n "$1" ] && code "$1"
  exit 0
fi

printf -v quoted_self '%q' "$SELF"
selected=$(FZRECENT_OPEN_STAY_COMMAND="$quoted_self --open-file" "$HELPERS/fzrecent" "$@")
[ -n "$selected" ] && code "$selected"
