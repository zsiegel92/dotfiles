#!/usr/bin/env bash
# Fuzzy-select a file under a directory, listed newest-modified first.
# Each row shows the modified date (Myyyy-MM-dd) next to the path (with the
# search directory's prefix stripped for readability). The full path is printed
# on selection. Preview shows the file contents.
# Set FZRECENT_OPEN_STAY_COMMAND to a shell-quoted command prefix to enable an
# open-without-closing-fzf shortcut. The selected path is appended to it.
usage() {
  cat <<'EOF'
Usage: fzrecent [OPTIONS] [DIR]

Fuzzy-select a recently modified file under DIR and print its path.
DIR defaults to the current directory. Options may appear before or after DIR.

Options:
  -d, --depth DEPTH  Include files through DEPTH nested directory levels.
                     DEPTH 0 means files directly in DIR; 1 also includes files
                     in its immediate subdirectories. The default is unlimited.
  -f, --flat         Show only files directly in DIR (equivalent to --depth 0).
  -h, --help         Show this help.

Picker shortcuts:
  Ctrl-R             Toggle between unlimited recursion and current-directory-only.
  Ctrl-A             Toggle filename and file-content search.
  Ctrl-J / Ctrl-K    Shrink / grow the file list.
  Alt-Up / Alt-Down  Scroll the preview.
  PgUp / PgDn        Scroll the preview by one page.
EOF
}

depth=""

validate_depth() {
  case "$depth" in
    '')
      return 0
      ;;
    *[!0-9]*)
      echo "fzrecent: depth must be a non-negative integer: $depth" >&2
      return 1
      ;;
  esac
}

set_depth() {
  depth="$1"
  if [ -z "$depth" ]; then
    echo "fzrecent: depth cannot be empty" >&2
    return 1
  fi
  validate_depth
}

list_recent_files() {
  local -a find_args=(-H "$dir")

  if [ -n "$depth" ]; then
    find_args+=(-maxdepth "$((depth + 1))")
  fi

  # Per file emit: epoch<TAB>Myyyy-MM-dd<TAB>fullpath. Sort newest-first, drop the
  # epoch sort key, then add a display column with the "<dir>/" prefix stripped:
  #   Myyyy-MM-dd<TAB>displayname<TAB>fullpath
  # fzf shows the date + display name, but returns (and previews) the full path.
  find "${find_args[@]}" -type f -print0 \
    | xargs -0 stat -f '%m	M%Sm	%N' -t '%Y-%m-%d' \
    | sort -rn \
    | cut -f2- \
    | awk -F'\t' -v pfx="${dir%/}/" 'BEGIN{OFS="\t"} { disp=$2; sub("^" pfx, "", disp); print $1, disp, $2 }'
}

content_filter_recent_files() {
  local filter_query="$1"

  list_recent_files | perl -F'\t' -lane '
    BEGIN {
      $query = shift @ARGV;
      @terms = grep { length } split /\s+/, lc($query // "");
      $max_term_len = 0;
      for $term (@terms) {
        $max_term_len = length($term) if length($term) > $max_term_len;
      }
    }

    if (!@terms) {
      print;
      next;
    }

    ($date, $display, $path) = @F;
    $haystack = lc(join("\t", $display // "", $path // ""));
    @missing = grep { index($haystack, $_) < 0 } @terms;

    if (@missing && defined($path) && open($fh, "<:raw", $path)) {
      $tail = "";
      while (@missing && read($fh, $chunk, 65536)) {
        $text = lc($tail . $chunk);
        @missing = grep { index($text, $_) < 0 } @missing;
        $tail = $max_term_len > 1 ? substr($chunk, -($max_term_len - 1)) : "";
      }
      close($fh);
    }

    print unless @missing;
  ' "$filter_query"
}

if [ "$1" = "--content-filter" ]; then
  shift
  dir="${FZRECENT_DIR:-.}"
  depth="${FZRECENT_DEPTH:-}"
  validate_depth || exit 2
  content_filter_recent_files "$1"
  exit
fi

adjust_selector_action() {
  local direction="$1" total_size selector_size preview_size step min_selector_size min_preview_size orientation border fallback header_columns helper_path quoted_header quoted_helper

  case "$direction" in
    decrease|increase) ;;
    *) return 2 ;;
  esac

  case "${FZF_PREVIEW_LEFT:-}" in
    ''|*[!0-9]*) return 0 ;;
  esac
  case "${FZF_PREVIEW_COLUMNS:-}" in
    ''|*[!0-9]*) return 0 ;;
  esac
  case "${FZF_PREVIEW_LINES:-}" in
    ''|*[!0-9]*) return 0 ;;
  esac
  case "${FZF_COLUMNS:-}" in
    ''|*[!0-9]*) return 0 ;;
  esac

  if [ "$FZF_PREVIEW_LEFT" -gt 0 ]; then
    total_size="$FZF_COLUMNS"
    selector_size=$((total_size - FZF_PREVIEW_COLUMNS))
    min_selector_size=5
    min_preview_size=20
    orientation=right
    border=border-left
    fallback='<100(down,50%,border-top,wrap)'
  else
    case "${FZF_LINES:-}" in
      ''|*[!0-9]*) return 0 ;;
    esac
    total_size="$FZF_LINES"
    selector_size=$((total_size - FZF_PREVIEW_LINES))
    min_selector_size=1
    min_preview_size=5
    orientation=down
    border=border-top
  fi

  [ "$total_size" -gt $((min_selector_size + min_preview_size)) ] || return 0

  step=$((total_size / 20))
  [ "$step" -lt 1 ] && step=1
  if [ "$direction" = "decrease" ]; then
    selector_size=$((selector_size - step))
  else
    selector_size=$((selector_size + step))
  fi
  [ "$selector_size" -lt "$min_selector_size" ] && selector_size="$min_selector_size"
  [ "$selector_size" -gt $((total_size - min_preview_size)) ] && selector_size=$((total_size - min_preview_size))
  preview_size=$((total_size - selector_size))

  if [ "$orientation" = "down" ]; then
    fallback="<100(down,$preview_size,border-top,wrap)"
    header_columns="$FZF_COLUMNS"
  else
    header_columns="$selector_size"
  fi

  if [ -z "${FZRECENT_HEADER:-}" ]; then
    printf 'change-preview-window[%s,%s,%s,wrap,%s]\n' "$orientation" "$preview_size" "$border" "$fallback"
    return
  fi

  helper_path="$(cd "$(dirname "$0")" && pwd)/fzf_wrap_header"
  printf -v quoted_header '%q' "$FZRECENT_HEADER"
  printf -v quoted_helper '%q' "$helper_path"
  printf 'change-preview-window[%s,%s,%s,wrap,%s]+transform-header[FZF_COLUMNS=%s %s --width-percent 100 --full-width-below 0 %s]\n' "$orientation" "$preview_size" "$border" "$fallback" "$header_columns" "$quoted_helper" "$quoted_header"
}

if [ "$1" = "--adjust-selector" ]; then
  adjust_selector_action "$2"
  exit $?
fi

dir=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -d|--depth)
      if [ "$#" -lt 2 ]; then
        echo "fzrecent: $1 requires a depth" >&2
        usage >&2
        exit 2
      fi
      set_depth "$2" || exit 2
      shift 2
      ;;
    --depth=*)
      set_depth "${1#*=}" || exit 2
      shift
      ;;
    -d?*)
      set_depth "${1#-d}" || exit 2
      shift
      ;;
    -f|--flat)
      depth=0
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      if [ "$#" -gt 1 ]; then
        echo "fzrecent: expected at most one directory" >&2
        usage >&2
        exit 2
      fi
      if [ "$#" -eq 1 ]; then
        dir="$1"
      fi
      break
      ;;
    -*)
      echo "fzrecent: unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      if [ -n "$dir" ]; then
        echo "fzrecent: expected at most one directory" >&2
        usage >&2
        exit 2
      fi
      dir="$1"
      shift
      ;;
  esac
done
dir="${dir:-.}"
validate_depth || exit 2

script_path="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
wrap_header_helper="${script_path%/*}/fzf_wrap_header"
query=""
mode="filename"
selected_path=""
toggle_marker="__fzrecent_toggle_content_search__"
depth_toggle_marker="__fzrecent_toggle_depth__"
preview_command='if command -v bat >/dev/null 2>&1; then bat --color=always --style=plain --wrap=character ${FZF_PREVIEW_COLUMNS:+--terminal-width="$FZF_PREVIEW_COLUMNS"} -- {3}; else cat -- {3}; fi'
scroll_bindings='alt-up:preview-up,alt-down:preview-down,alt-u:preview-page-up,alt-d:preview-page-down,page-up:preview-page-up,page-down:preview-page-down'
open_stay_command="${FZRECENT_OPEN_STAY_COMMAND:-}"
open_stay_key_label=""
open_stay_bind=""

shell_quote() {
  printf '%q' "$1"
}

if [ -n "$open_stay_command" ]; then
  if printf 'x\n' | fzf --filter x --bind 'ctrl-enter:execute-silent(true)' >/dev/null 2>&1; then
    open_stay_key_label="ctrl-enter"
    open_stay_bind="ctrl-enter:execute-silent($open_stay_command {3})"
  else
    open_stay_key_label="alt-enter"
    open_stay_bind="alt-enter:execute-silent($open_stay_command {3})"
  fi
fi

scroll_bindings+=',pgup:preview-page-up,pgdn:preview-page-down'
adjust_selector_command="$(shell_quote "$script_path") --adjust-selector"
scroll_bindings+=",ctrl-j:transform($adjust_selector_command decrease),ctrl-k:transform($adjust_selector_command increase)"
[ -n "$open_stay_bind" ] && scroll_bindings+=",$open_stay_bind"

parse_picker_output() {
  local picker_output="$1"
  local second_line third_line selected_line

  query=$(printf '%s\n' "$picker_output" | sed -n '1p')
  second_line=$(printf '%s\n' "$picker_output" | sed -n '2p')
  third_line=$(printf '%s\n' "$picker_output" | sed -n '3p')

  if [ "$second_line" = "$toggle_marker" ]; then
    return 2
  fi
  if [ "$second_line" = "$depth_toggle_marker" ]; then
    return 3
  fi

  if [ -n "$third_line" ] || [ -z "$second_line" ]; then
    selected_line="$third_line"
  else
    selected_line="$second_line"
  fi

  if [ -z "$selected_line" ]; then
    return 1
  fi

  selected_path=$(printf '%s\n' "$selected_line" | awk -F'\t' '{print $3}')
  [ -n "$selected_path" ]
}

run_picker() {
  local picker_output picker_status parse_status filter_command header prompt scope_label depth_toggle_label

  if [ -z "$depth" ]; then
    scope_label="recursive"
    depth_toggle_label="current only"
  elif [ "$depth" -eq 0 ]; then
    scope_label="current only"
    depth_toggle_label="recursive"
  elif [ "$depth" -eq 1 ]; then
    scope_label="1 nested level"
    depth_toggle_label="recursive"
  else
    scope_label="$depth nested levels"
    depth_toggle_label="recursive"
  fi

  if [ "$mode" = "content" ]; then
    header="scope: $scope_label · ctrl-r: use $depth_toggle_label · enter: select · ctrl-a: filename search${open_stay_key_label:+ · $open_stay_key_label: open+stay} · ctrl-j/k: resize · alt-up/down, pgup/dn: preview"
    prompt='text> '
    filter_command="FZRECENT_DIR=$(shell_quote "$dir") FZRECENT_DEPTH=$(shell_quote "$depth") $(shell_quote "$script_path") --content-filter"
    export FZRECENT_HEADER="$header"
    header=$("$wrap_header_helper" --width-percent 40 --full-width-below 100 "$header") || return
    picker_output=$(content_filter_recent_files "$query" | fzf \
      --disabled \
      --query="$query" \
      --print-query \
      --no-sort \
      --no-mouse \
      --ansi \
      --delimiter='\t' \
      --tabstop=1 \
      --with-nth=1,2 \
      --prompt="$prompt" \
      --header="$header" \
      --preview-window='right,60%,<100(down,50%,border-top)' \
      --bind "$scroll_bindings" \
      --bind "ctrl-a:print($toggle_marker)+accept" \
      --bind "ctrl-r:print($depth_toggle_marker)+accept" \
      --bind "change:reload:$filter_command {q}" \
      --preview "$preview_command")
  else
    header="scope: $scope_label · ctrl-r: use $depth_toggle_label · enter: select · ctrl-a: search file text${open_stay_key_label:+ · $open_stay_key_label: open+stay} · ctrl-j/k: resize · alt-up/down, pgup/dn: preview"
    prompt='files> '
    export FZRECENT_HEADER="$header"
    header=$("$wrap_header_helper" --width-percent 40 --full-width-below 100 "$header") || return
    picker_output=$(list_recent_files | fzf \
      --query="$query" \
      --print-query \
      --no-sort \
      --no-mouse \
      --ansi \
      --delimiter='\t' \
      --tabstop=1 \
      --with-nth=1,2 \
      --prompt="$prompt" \
      --header="$header" \
      --preview-window='right,60%,<100(down,50%,border-top)' \
      --bind "$scroll_bindings" \
      --bind "ctrl-a:print($toggle_marker)+accept" \
      --bind "ctrl-r:print($depth_toggle_marker)+accept" \
      --preview "$preview_command")
  fi
  picker_status=$?

  parse_picker_output "$picker_output"
  parse_status=$?
  if [ "$parse_status" -eq 0 ] || [ "$parse_status" -eq 2 ] || [ "$parse_status" -eq 3 ]; then
    return "$parse_status"
  fi

  if [ "$picker_status" -ne 0 ]; then
    return "$picker_status"
  fi

  return "$parse_status"
}

while true; do
  run_picker
  picker_status=$?

  case "$picker_status" in
    0)
      printf '%s\n' "$selected_path"
      exit 0
      ;;
    2)
      if [ "$mode" = "content" ]; then
        mode="filename"
      else
        mode="content"
      fi
      ;;
    3)
      if [ -z "$depth" ]; then
        depth=0
      else
        depth=""
      fi
      ;;
    *)
      exit "$picker_status"
      ;;
  esac
done
