#!/usr/bin/expect -f

# Smoke-test gscode's fzf layout in a real pseudo-terminal.
# Run from anywhere with: bin/helpers/test_gscode_tui.exp

set timeout 8
set helper_dir [file dirname [file normalize [info script]]]
set gscode [file normalize [file join $helper_dir .. gscode]]

proc fail {message} {
    puts stderr "FAIL: $message"
    exit 1
}

proc assert_equal {label actual expected} {
    if {$actual ne $expected} {
        fail "$label\nexpected: $expected\nactual:   $actual"
    }
}

proc assert_contains {label actual expected} {
    if {[string first $expected $actual] < 0} {
        fail "$label\nexpected to contain: $expected\nactual:              $actual"
    }
}

proc check_layout_actions {gscode} {
    set unified_one [exec env {FZF_PREVIEW_LABEL=unified diff} FZF_LINES=40 FZF_COLUMNS=80 FZF_MATCH_COUNT=1 $gscode --fit-preview short 94]
    assert_equal "one-match unified layout" $unified_one {change-preview-window[right,50%,border-left,wrap,<100(down,85%,border-top,wrap)]}

    set unified_many [exec env {FZF_PREVIEW_LABEL=unified diff} FZF_LINES=40 FZF_COLUMNS=80 FZF_MATCH_COUNT=30 $gscode --fit-preview short 94]
    assert_equal "many-match unified layout" $unified_many {change-preview-window[right,50%,border-left,wrap,<100(down,50%,border-top,wrap)]}

    set side_by_side_one [exec env {FZF_PREVIEW_LABEL=side-by-side hunks} FZF_LINES=40 FZF_COLUMNS=80 FZF_MATCH_COUNT=1 FZF_PREVIEW_LINES=20 $gscode --fit-preview short 94]
    assert_equal "one-match side-by-side layout" $side_by_side_one {change-preview-window[down,34,border-top,nowrap,<100(down,34,border-top,nowrap)]}

    puts "PASS: match-aware layout actions"
}

proc check_current_file_preview_actions {gscode} {
    set current_file [exec env {FZF_PREVIEW_LABEL=unified diff} FZF_LINES=40 FZF_COLUMNS=80 FZF_MATCH_COUNT=1 $gscode --toggle-current-file {picker header} 1 --content-query needle]
    assert_contains "Ctrl-P enables the current-file preview" $current_file {change-preview-label[current file]}
    assert_contains "Ctrl-P uses the persistent current-file preview command" $current_file {--preview-current-file --content-query needle {2}}

    set unified_diff [exec env {FZF_PREVIEW_LABEL=current file} FZF_LINES=40 FZF_COLUMNS=80 FZF_MATCH_COUNT=1 $gscode --toggle-current-file {picker header} 1 --content-query needle]
    assert_contains "Ctrl-P restores the unified diff preview" $unified_diff {change-preview-label[unified diff]}
    assert_contains "Ctrl-P restores the unified diff preview command" $unified_diff {--preview-file --content-query needle {2}}

    set live_query [exec env {FZF_PREVIEW_LABEL=unified diff} FZF_LINES=40 FZF_COLUMNS=80 FZF_MATCH_COUNT=1 $gscode --toggle-current-file {picker header} 1 --live-content-query]
    assert_contains "Ctrl-P keeps content-mode highlights live" $live_query {--preview-current-file --content-query {q} {2}}

    puts "PASS: current-file preview actions"
}

proc check_query_toggle_action {gscode} {
    set current_file [exec env {FZF_PREVIEW_LABEL=current file} $gscode --toggle-query-mode marker]
    assert_equal "Ctrl-W preserves the current-file preview label" $current_file {print[marker]+print[current file]+accept}

    set side_by_side [exec env {FZF_PREVIEW_LABEL=side-by-side hunks} $gscode --toggle-query-mode marker]
    assert_equal "Ctrl-W preserves the side-by-side preview label" $side_by_side {print[marker]+print[side-by-side hunks]+accept}

    puts "PASS: query-toggle preview state"
}

# Each of these must be rejected before the picker starts.
proc check_compare_option_validation {gscode} {
    foreach {label arguments expected} {
        "-c with -b" {-c HEAD~1..HEAD -b HEAD~1} {choose only one of}
        "-c with -g" {-c HEAD~1..HEAD -g} {choose only one of}
        "-c with --branch=" {-c HEAD~1..HEAD --branch=HEAD~1} {choose only one of}
        "-c without a range" {-c HEAD} {expects a range like A..B or A...B}
        "-c with an unknown ref" {-c no-such-ref..HEAD} {branch/ref not found: no-such-ref}
        "-b with a range" {-b HEAD~1..HEAD} {use -c/--compare}
    } {
        if {![catch {exec $gscode {*}$arguments 2>@1} output]} {
            fail "$label should have been rejected"
        }
        assert_contains "$label error message" $output $expected
    }

    puts "PASS: -c/--compare validation and exclusivity"
}

# Drain redraws until the screen goes quiet, then return the last preview
# position fzf drew (the N in its "N/605" indicator for the fixture diff).
proc preview_position {} {
    set screen ""
    expect {
        -timeout 1 -re {.+} { append screen $expect_out(0,string); exp_continue }
        timeout {}
    }
    set last ""
    foreach {_ n} [regexp -all -inline {([0-9]+)/605} $screen] { set last $n }
    return $last
}

# Drive the real picker over a long diff and read fzf's preview position
# indicator (N/total) after each key. Alt-Up/Down must scroll one line;
# Alt-Shift-Up/Down must scroll a page, the same distance as PgUp/PgDn.
proc check_preview_scroll_keys {gscode} {
    set repo [exec mktemp -d -t gscode-scroll-test]
    set git [list git -C $repo -c user.name=gscode-test -c user.email=gscode-test@example.com -c commit.gpgsign=false -c core.hooksPath=/dev/null]
    exec {*}$git init -q
    exec sh -c {seq 1 300 | sed 's/^/line /' > "$0/big.txt"} $repo
    exec {*}$git add big.txt
    exec {*}$git commit -q -m add
    exec sh -c {seq 1 300 | sed 's/^/changed /' > "$0/big.txt"} $repo

    log_user 0
    spawn -noecho sh -c {cd "$0" && exec "$1"} $repo $gscode
    set slave $spawn_out(slave,name)
    if {[catch {exec stty -f $slave rows 40 columns 160} error]} {
        catch {close}
        catch {wait}
        file delete -force $repo
        fail "scroll keys: could not size the terminal: $error"
    }

    set initial [preview_position]
    send "\x1b\[1;3B"; set line_down [preview_position]
    send "\x1b\[1;3A"; set line_up [preview_position]
    send "\x1b\[1;4B"; set page_down [preview_position]
    send "\x1b\[1;4A"; set page_up [preview_position]
    send "\x1b\[6~";   set pgdn [preview_position]

    send "\003"
    catch {expect eof}
    catch {wait}
    file delete -force $repo

    assert_equal "initial preview position" $initial 1
    assert_equal "Alt-Down scrolls one line" $line_down 2
    assert_equal "Alt-Up scrolls one line back" $line_up 1
    if {$page_down eq "" || $page_down <= 2} {
        fail "Alt-Shift-Down should scroll by a page, but the preview position went from 1 to '$page_down'"
    }
    assert_equal "Alt-Shift-Up scrolls one page back" $page_up 1
    assert_equal "Alt-Shift-Down pages like PgDn" $page_down $pgdn

    puts "PASS: Alt-Up/Down scroll by line and Alt-Shift-Up/Down scroll by page"
}

proc resize_smoke {gscode mode arguments} {
    log_user 0
    spawn -noecho $gscode {*}$arguments
    set child_pid [exp_pid]
    set slave $spawn_out(slave,name)

    if {[catch {exec stty -f $slave rows 40 columns 220} error]} {
        catch {close}
        catch {wait}
        fail "$mode initial terminal sizing: $error"
    }

    after 500
    for {set index 0} {$index < 200} {incr index} {
        set columns [expr {60 + (($index * 41) % 170)}]
        if {[catch {exec stty -f $slave rows 40 columns $columns} error]} {
            catch {send "\003"}
            catch {close}
            catch {wait}
            fail "$mode resize iteration $index: $error"
        }
        after 4
    }

    after 200
    send "\003"
    expect {
        eof {}
        timeout {
            catch {send "\003"}
            catch {exec kill -TERM $child_pid}
            catch {close}
            catch {wait}
            fail "$mode did not exit after Ctrl-C following resize burst"
        }
    }

    set result [wait]
    if {[lindex $result 3] != 0} {
        fail "$mode exited with status [lindex $result 3]"
    }
    puts "PASS: $mode survives rapid horizontal resizing"
}

if {![file executable $gscode]} {
    fail "gscode is not executable: $gscode"
}

set source_handle [open $gscode r]
set source [read $source_handle]
close $source_handle
if {[string first {resize:} $source] >= 0} {
    fail "gscode must not bind external work to fzf's resize event"
}
if {[string first {--no-sort} $source] >= 0} {
    fail "gscode must let fzf rank filename matches by relevance"
}

check_layout_actions $gscode
check_current_file_preview_actions $gscode
check_query_toggle_action $gscode
check_compare_option_validation $gscode
check_preview_scroll_keys $gscode
resize_smoke $gscode "unified mode" [list -b HEAD~1]
resize_smoke $gscode "side-by-side mode" [list -s -b HEAD~1]
resize_smoke $gscode "compare mode" [list -c HEAD~1..HEAD]
resize_smoke $gscode "side-by-side compare mode" [list -s -c HEAD~1...HEAD]
puts "PASS: all gscode TUI smoke tests"
