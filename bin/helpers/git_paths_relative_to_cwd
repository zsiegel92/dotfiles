#!/usr/bin/env bash
# Convert repo-root-relative Git paths from stdin to paths relative to $PWD.
# With --field N, preserve tab-separated records and convert only field N.

path_field=1
if [ "$1" = "--field" ]; then
    path_field="$2"
fi

prefix=$(git rev-parse --show-prefix 2>/dev/null) || exit
cwd_components=()

if [ -n "$prefix" ]; then
    IFS=/ read -r -a components <<< "${prefix%/}"
    cwd_components=("${components[@]}")
fi

while IFS= read -r input_line; do
    if [ "$path_field" -eq 1 ]; then
        repo_path="$input_line"
    else
        IFS=$'\t' read -r -a fields <<< "$input_line"
        repo_path="${fields[$((path_field - 1))]}"
    fi
    [ -n "$repo_path" ] || continue

    IFS=/ read -r -a path_components <<< "$repo_path"
    common=0

    while [ "$common" -lt "${#cwd_components[@]}" ] \
        && [ "$common" -lt "${#path_components[@]}" ] \
        && [ "${cwd_components[$common]}" = "${path_components[$common]}" ]; do
        ((common++))
    done

    relative=
    for ((i = common; i < ${#cwd_components[@]}; i++)); do
        relative="${relative}../"
    done

    rest=
    for ((i = common; i < ${#path_components[@]}; i++)); do
        if [ -n "$rest" ]; then
            rest="${rest}/${path_components[$i]}"
        else
            rest="${path_components[$i]}"
        fi
    done

    relative_path="${relative}${rest}"
    if [ "$path_field" -eq 1 ]; then
        printf '%s\n' "$relative_path"
    else
        fields[$((path_field - 1))]="$relative_path"
        (IFS=$'\t'; printf '%s\n' "${fields[*]}")
    fi
done
