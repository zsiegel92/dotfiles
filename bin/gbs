#!/usr/bin/env bash
# Fuzzy-select a branch and check it out.
# Usage: gbs [-g|--graph|--tree|-f|--full-dag|-h|--handmade-dag|-y|--git-graph] [-a|--all-ancestry] [query]
# In fzf, switch+stay checks out the highlighted branch without leaving the picker.
branch=$(select_git_branch --switch-stay "$@")
if [ -n "$branch" ]; then
    echo "git checkout $branch"
    git checkout "$branch"
fi
