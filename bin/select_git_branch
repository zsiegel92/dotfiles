#!/usr/bin/env bash
# Fuzzy-select a git branch; prints the chosen branch name (no leading markers).
# Usage: select_git_branch [-g|--graph|--tree] [query]
initial_view_mode=list

case "$1" in
  -g|--graph|--tree)
    initial_view_mode=tree
    shift
    ;;
esac

query="$*"

select_git_branch_rows() {
  git branch --format='%(HEAD)%09%(refname:short)%09%(objectname)' | awk -F '\t' '
    BEGIN {
      OFS = "\t"
    }

    {
      marker = $1 == "*" ? "*" : " "
      print $2, marker " " $2, $3, marker
    }
  '
}

select_git_branch_tree_rows() {
  python3 -c '
import collections
import subprocess
import sys

rows = []
for line in sys.stdin:
    line = line.rstrip("\n")
    if not line:
        continue

    parts = line.split("\t")
    if len(parts) < 4:
        continue

    rows.append({
        "branch": parts[0],
        "oid": parts[2],
        "marker": parts[3],
    })

if not rows:
    sys.exit(0)

try:
    result = subprocess.run(
        ["git", "rev-list", "--parents", "--branches"],
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
except subprocess.CalledProcessError as exc:
    sys.stderr.write(exc.stderr)
    sys.exit(exc.returncode)

parents_by_commit = {}
for line in result.stdout.splitlines():
    parts = line.split()
    if parts:
        parents_by_commit[parts[0]] = parts[1:]

tip_indices_by_oid = collections.defaultdict(list)
for index, row in enumerate(rows):
    tip_indices_by_oid[row["oid"]].append(index)

parent_indices = [None] * len(rows)

for index, row in enumerate(rows):
    start_oid = row["oid"]
    queue = collections.deque()
    seen = {start_oid}

    for parent_oid in parents_by_commit.get(start_oid, []):
        if parent_oid not in seen:
            seen.add(parent_oid)
            queue.append(parent_oid)

    while queue:
        oid = queue.popleft()
        found_parent = None

        for candidate_index in tip_indices_by_oid.get(oid, []):
            if candidate_index != index and rows[candidate_index]["oid"] != start_oid:
                found_parent = candidate_index
                break

        if found_parent is not None:
            parent_indices[index] = found_parent
            break

        for parent_oid in parents_by_commit.get(oid, []):
            if parent_oid not in seen:
                seen.add(parent_oid)
                queue.append(parent_oid)

children = [[] for _ in rows]
roots = []

for index, parent_index in enumerate(parent_indices):
    if parent_index is None:
        roots.append(index)
    else:
        children[parent_index].append(index)

rendered = set()

def visible_branch(index):
    branch = rows[index]["branch"]
    if rows[index]["marker"] == "*":
        return "* " + branch
    return branch

def render(index, prefix, is_last, depth):
    if index in rendered:
        return

    rendered.add(index)
    row = rows[index]

    if depth == 0:
        display = visible_branch(index)
        next_prefix = ""
    else:
        connector = "└── " if is_last else "├── "
        display = prefix + connector + visible_branch(index)
        next_prefix = prefix + ("    " if is_last else "│   ")

    print("\t".join([row["branch"], display, row["oid"], row["marker"]]))

    child_indices = children[index]
    for child_position, child_index in enumerate(child_indices):
        render(child_index, next_prefix, child_position == len(child_indices) - 1, depth + 1)

for root_index in roots:
    render(root_index, "", True, 0)

for index in range(len(rows)):
    if index not in rendered:
        render(index, "", True, 0)
'
}

select_git_branch_fzf() {
  local rows="$1"
  local header="$2"
  local view_mode="$3"
  local current_query="$4"
  local fzf_args=(
    --query="$current_query"
    --print-query
    --no-mouse
    --no-sort
    --height 90%
    --ansi
    --border
    --wrap
    --delimiter=$'\t'
    --with-nth=2
    --accept-nth=1
    --expect=ctrl-g
    --preview-window=up:3
    --header="$header"
    --bind="alt-up:preview-up,alt-down:preview-down"
    --preview 'git log --oneline --graph --decorate --color=always --date=short --pretty=format:"%C(auto)%h %ad | %C(reset)%s%C(auto)%d%C(reset)[%an]" {1} --'
  )

  if [ "$view_mode" = tree ]; then
    fzf_args+=(--layout=reverse)
  else
    fzf_args+=(--tac)
  fi

  printf '%s\n' "$rows" | fzf "${fzf_args[@]}"
}

select_git_branch_from_selected_row() {
  local selected_row="$1"
  local selected_branch

  selected_branch=${selected_row%%$'\t'*}
  if [ "$selected_branch" = "$selected_row" ]; then
    selected_branch=$(printf '%s\n' "$selected_branch" | sed -e 's/^[[:space:]│]*[├└]──[[:space:]]*//' -e 's/^[[:space:]]*//' -e 's/^\* //')
  fi

  printf '%s\n' "$selected_branch"
}

branch_rows=$(select_git_branch_rows) || exit
tree_branch_rows=$(printf '%s\n' "$branch_rows" | select_git_branch_tree_rows) || exit
view_mode="$initial_view_mode"
current_query="$query"

while true; do
  if [ "$view_mode" = tree ]; then
    active_rows="$tree_branch_rows"
    header='enter: select branch, ctrl-g: list view, alt-up/down: scroll preview'
  else
    active_rows="$branch_rows"
    header='enter: select branch, ctrl-g: graph view, alt-up/down: scroll preview'
  fi

  selected=$(select_git_branch_fzf "$active_rows" "$header" "$view_mode" "$current_query")
  fzf_status=$?

  if [ "$fzf_status" -ne 0 ]; then
    exit "$fzf_status"
  fi

  current_query=${selected%%$'\n'*}
  rest=${selected#*$'\n'}
  pressed_key=${rest%%$'\n'*}
  selected_row=${rest#*$'\n'}

  if [ "$selected_row" = "$rest" ]; then
    selected_row=""
  fi

  if [ -z "$selected_row" ] && [ "$pressed_key" != ctrl-g ]; then
    selected_row="$pressed_key"
    pressed_key=
  fi

  if [ "$pressed_key" = ctrl-g ]; then
    if [ "$view_mode" = tree ]; then
      view_mode=list
    else
      view_mode=tree
    fi
    continue
  fi

  if [ -n "$selected_row" ]; then
    select_git_branch_from_selected_row "$selected_row"
  fi

  exit
done
