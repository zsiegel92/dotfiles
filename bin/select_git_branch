#!/usr/bin/env bash
# Fuzzy-select a git branch; prints the chosen branch name (no leading markers).
# Usage: select_git_branch [-g|--graph|--tree|-f|--full-dag|-h|--handmade-dag|-y|--git-graph] [-a|--all-ancestry] [--start-branch <branch>] [query]
# --start-branch puts the cursor on <branch>'s row when the picker first opens. It is
# ignored when a starting query filters the list, since the row's position would be off.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SELF="$SCRIPT_DIR/$(basename "$0")"
FZF_WRAP_HEADER="$SCRIPT_DIR/helpers/fzf_wrap_header"

if [ "$1" = "--switch-stay-branch" ]; then
  branch="$2"
  if [ -n "$branch" ]; then
    echo "git checkout $branch"
    git checkout "$branch"
  fi
  exit
fi

# Internal: invoked by the fzf ctrl-x binding. Copies "<parent>..<branch>", or
# nothing when the branch has no inferred parent.
if [ "$1" = "--copy-branch-range" ]; then
  branch="$2"
  if [ -n "$branch" ]; then
    parent=$("$SCRIPT_DIR/gparent" "$branch" 2>/dev/null) || exit
    if [ -n "$parent" ]; then
      printf '%s..%s' "$parent" "$branch" | pbcopy
    fi
  fi
  exit
fi

initial_view_mode=list
initial_preview_scope=main
enable_switch_stay=0
start_branch=

while [ "$#" -gt 0 ]; do
  case "$1" in
    --switch-stay)
      enable_switch_stay=1
      shift
      ;;
    --start-branch)
      if [ "$#" -lt 2 ]; then
        echo "select_git_branch: --start-branch requires a branch" >&2
        exit 2
      fi
      start_branch="$2"
      shift 2
      ;;
    -g|--graph|--tree)
      initial_view_mode=tree
      shift
      ;;
    -f|--full|--full-dag|--dag)
      initial_view_mode=full-dag
      shift
      ;;
    -h|--handmade|--handmade-dag|--branch-dag)
      initial_view_mode=handmade-dag
      shift
      ;;
    -y|--git-graph|--y-graph)
      initial_view_mode=git-graph
      shift
      ;;
    -a|--all|--all-ancestry)
      initial_preview_scope=all
      shift
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

query="$*"
SELECT_GIT_BRANCH_TREE_ROWS="$SCRIPT_DIR/python/select_git_branch_tree_rows.py"

select_git_branch_rows() {
  git branch --format='%(HEAD)%09%(refname:short)%09%(objectname)' | awk -F '\t' '
    BEGIN {
      OFS = "\t"
    }

    {
      marker = $1 == "*" ? "*" : " "
      print $2, marker " " $2, $3, marker
    }
  '
}

select_git_branch_tree_rows() {
  uv run --script "$SELECT_GIT_BRANCH_TREE_ROWS"
}

select_git_branch_full_dag_rows() {
  uv run --script "$SELECT_GIT_BRANCH_TREE_ROWS" --full-dag
}

select_git_branch_handmade_dag_rows() {
  uv run --script "$SELECT_GIT_BRANCH_TREE_ROWS" --handmade-dag
}

select_git_branch_git_graph_rows() {
  uv run --script "$SELECT_GIT_BRANCH_TREE_ROWS" --git-graph
}

select_git_branch_tree_like_view() {
  [ "$1" = tree ] || [ "$1" = full-dag ] || [ "$1" = handmade-dag ] || [ "$1" = git-graph ]
}

# Print the 1-based position fzf gives a branch's row in the result list, or
# nothing if no row is that branch. The list view runs fzf with --tac, which
# numbers the rows from the end of the input; the other views keep input order.
select_git_branch_row_position() {
  local rows="$1"
  local branch="$2"
  local view_mode="$3"
  local reversed=1

  if select_git_branch_tree_like_view "$view_mode"; then
    reversed=0
  fi

  printf '%s\n' "$rows" | awk -F '\t' -v branch="$branch" -v reversed="$reversed" '
    $1 == branch && !found { found = NR }
    END { if (found) print reversed ? NR - found + 1 : found }
  '
}

select_git_branch_fzf() {
  local rows="$1"
  local header="$2"
  local view_mode="$3"
  local current_query="$4"
  local preview_scope="$5"
  local switch_stay_bind="$6"
  local start_branch="$7"
  local preview_command
  local start_position

  header=$("$FZF_WRAP_HEADER" "$header") || return

  if [ "$view_mode" = tree ]; then
    preview_command="'$SELECT_GIT_BRANCH_TREE_ROWS' --diff-preview --tree {1}"
  elif [ "$view_mode" = full-dag ]; then
    preview_command="'$SELECT_GIT_BRANCH_TREE_ROWS' --diff-preview --full-dag {1}"
  elif [ "$preview_scope" = all ]; then
    preview_command="'$SELECT_GIT_BRANCH_TREE_ROWS' --preview --all {1}"
  else
    preview_command="'$SELECT_GIT_BRANCH_TREE_ROWS' --preview {1}"
  fi

  local fzf_args=(
    --query="$current_query"
    --print-query
    --no-mouse
    --no-sort
    --height 90%
    --ansi
    --border
    --wrap
    --delimiter=$'\t'
    --with-nth=2
    --accept-nth=1
    --expect=ctrl-g,ctrl-f,ctrl-h,ctrl-y
    --header="$header"
    --bind="ctrl-w:execute-silent(sh -c 'branch=\$1; [ -n \"\$branch\" ] && glab mr view \"\$branch\" --web >/dev/null 2>&1 &' sh {1})"
    --bind="ctrl-b:execute-silent(sh -c 'if [ -n \"\$1\" ]; then printf \"%s\" \"\$1\" | pbcopy; fi' sh {1})"
    --bind="ctrl-x:execute-silent($quoted_self --copy-branch-range {1})"
    --bind="alt-up:preview-up,alt-down:preview-down"
    --bind="enter:transform:[[ -n {1} ]] && echo accept || echo 'change-header:Select a branch row'"
    --preview "$preview_command"
  )

  if [ -n "$switch_stay_bind" ]; then
    fzf_args+=(--bind="$switch_stay_bind")
  fi

  # Jump once the list has loaded, then unbind so later reloads (switch+stay)
  # keep the cursor where it is.
  if [ -n "$start_branch" ] && [ -z "$current_query" ]; then
    start_position=$(select_git_branch_row_position "$rows" "$start_branch" "$view_mode")
    if [ -n "$start_position" ]; then
      fzf_args+=(--bind="load:pos($start_position)+unbind(load)")
    fi
  fi

  if select_git_branch_tree_like_view "$view_mode"; then
    fzf_args+=(--layout=reverse)
  else
    fzf_args+=(--tac)
  fi

  fzf_args+=(--preview-window=up:40%:wrap)

  printf '%s\n' "$rows" | fzf "${fzf_args[@]}"
}

select_git_branch_from_selected_row() {
  local selected_row="$1"
  local selected_branch

  selected_branch=${selected_row%%$'\t'*}
  if [ "$selected_branch" = "$selected_row" ]; then
    selected_branch=$(printf '%s\n' "$selected_branch" | sed -e 's/^[[:space:]│]*[├└]──*[[:space:]]*//' -e 's/^[[:space:]│|\\/*●┬┴╋]*//' -e 's/^[[:space:]]*//' -e 's/^\* //' -e 's/[[:space:]]<-[[:space:]].*$//')
  fi

  printf '%s\n' "$selected_branch"
}

rows_for_view_mode() {
  case "$1" in
    tree) printf '%s\n' "$branch_rows" | select_git_branch_tree_rows ;;
    full-dag) printf '%s\n' "$branch_rows" | select_git_branch_full_dag_rows ;;
    handmade-dag) printf '%s\n' "$branch_rows" | select_git_branch_handmade_dag_rows ;;
    git-graph) select_git_branch_git_graph_rows ;;
    *) printf '%s\n' "$branch_rows" ;;
  esac
}

# Internal: invoked by the fzf switch+stay reload. Prints the rows for a view
# mode, read fresh so the HEAD marker reflects the branch just checked out.
if [ "$1" = "--rows" ]; then
  branch_rows=$(select_git_branch_rows) || exit
  rows_for_view_mode "$2"
  exit
fi

branch_rows=$(select_git_branch_rows) || exit
tree_branch_rows=$(printf '%s\n' "$branch_rows" | select_git_branch_tree_rows) || exit
view_mode="$initial_view_mode"
current_query="$query"
preview_scope="$initial_preview_scope"
switch_stay_key_label=
printf -v quoted_self '%q' "$SELF"

if [ "$enable_switch_stay" -eq 1 ]; then
  if printf 'x\n' | fzf --filter x --bind 'ctrl-enter:execute-silent(true)' >/dev/null 2>&1; then
    switch_stay_key_label=ctrl-enter
    switch_stay_keys=(ctrl-enter)
  else
    switch_stay_key_label=ctrl-j/alt-enter
    switch_stay_keys=(ctrl-j alt-enter)
  fi
fi

while true; do
  switch_stay_bind=
  if [ "$enable_switch_stay" -eq 1 ]; then
    for key in "${switch_stay_keys[@]}"; do
      [ -n "$switch_stay_bind" ] && switch_stay_bind+=","
      switch_stay_bind+="$key:execute($quoted_self --switch-stay-branch {1})+reload($quoted_self --rows $view_mode)"
    done
  fi

  switch_stay_header=
  if [ -n "$switch_stay_key_label" ]; then
    switch_stay_header="$switch_stay_key_label: switch+stay, "
  fi

  if [ "$view_mode" = tree ]; then
    active_rows="$tree_branch_rows"
    header="enter: select branch, ${switch_stay_header}ctrl-w: open MR in GitLab, ctrl-b: copy branch, ctrl-x: copy parent..branch, ctrl-g: list view, ctrl-f: full DAG view, ctrl-h: handmade DAG view, ctrl-y: git graph view, preview: files vs parent"
  elif [ "$view_mode" = full-dag ]; then
    if [ -z "${full_dag_branch_rows+x}" ]; then
      full_dag_branch_rows=$(printf '%s\n' "$branch_rows" | select_git_branch_full_dag_rows) || exit
    fi

    active_rows="$full_dag_branch_rows"
    header="enter: select branch, ${switch_stay_header}ctrl-w: open MR in GitLab, ctrl-b: copy branch, ctrl-x: copy parent..branch, ctrl-g: tree view, ctrl-f: list view, ctrl-h: handmade DAG view, ctrl-y: git graph view, preview: files vs parent"
  elif [ "$view_mode" = handmade-dag ]; then
    if [ -z "${handmade_dag_branch_rows+x}" ]; then
      handmade_dag_branch_rows=$(printf '%s\n' "$branch_rows" | select_git_branch_handmade_dag_rows) || exit
    fi

    active_rows="$handmade_dag_branch_rows"
    header="enter: select branch, ${switch_stay_header}ctrl-w: open MR in GitLab, ctrl-b: copy branch, ctrl-x: copy parent..branch, ctrl-g: tree view, ctrl-f: full DAG view, ctrl-h: list view, ctrl-y: git graph view, alt-up/down: scroll preview"
  elif [ "$view_mode" = git-graph ]; then
    if [ -z "${git_graph_branch_rows+x}" ]; then
      git_graph_branch_rows=$(select_git_branch_git_graph_rows) || exit
    fi

    active_rows="$git_graph_branch_rows"
    header="enter: select branch row, ${switch_stay_header}ctrl-w: open MR in GitLab, ctrl-b: copy branch, ctrl-x: copy parent..branch, ctrl-g: tree view, ctrl-f: full DAG view, ctrl-h: handmade DAG view, ctrl-y: list view, alt-up/down: scroll preview"
  else
    active_rows="$branch_rows"
    header="enter: select branch, ${switch_stay_header}ctrl-w: open MR in GitLab, ctrl-b: copy branch, ctrl-x: copy parent..branch, ctrl-g: tree view, ctrl-f: full DAG view, ctrl-h: handmade DAG view, ctrl-y: git graph view, alt-up/down: scroll preview"
  fi

  selected=$(select_git_branch_fzf "$active_rows" "$header" "$view_mode" "$current_query" "$preview_scope" "$switch_stay_bind" "$start_branch")
  fzf_status=$?
  # Only the first picker opens on --start-branch; later ones (view switches) start fresh.
  start_branch=

  if [ "$fzf_status" -ne 0 ]; then
    exit "$fzf_status"
  fi

  current_query=${selected%%$'\n'*}
  rest=${selected#*$'\n'}
  pressed_key=${rest%%$'\n'*}
  selected_row=${rest#*$'\n'}

  if [ "$selected_row" = "$rest" ]; then
    selected_row=""
  fi

  if [ -z "$selected_row" ] && [ "$pressed_key" != ctrl-g ] && [ "$pressed_key" != ctrl-f ] && [ "$pressed_key" != ctrl-h ] && [ "$pressed_key" != ctrl-y ]; then
    selected_row="$pressed_key"
    pressed_key=
  fi

  if [ "$pressed_key" = ctrl-g ]; then
    if [ "$view_mode" = tree ]; then
      view_mode=list
    elif [ "$view_mode" = full-dag ]; then
      view_mode=tree
      preview_scope=main
    else
      view_mode=tree
    fi
    continue
  fi

  if [ "$pressed_key" = ctrl-f ]; then
    if [ "$view_mode" = full-dag ]; then
      view_mode=list
      preview_scope=main
    else
      view_mode=full-dag
    fi
    continue
  fi

  if [ "$pressed_key" = ctrl-h ]; then
    if [ "$view_mode" = handmade-dag ]; then
      view_mode=list
    else
      view_mode=handmade-dag
      preview_scope=main
    fi
    continue
  fi

  if [ "$pressed_key" = ctrl-y ]; then
    if [ "$view_mode" = git-graph ]; then
      view_mode=list
    else
      view_mode=git-graph
      preview_scope=main
    fi
    continue
  fi

  if [ -n "$selected_row" ]; then
    select_git_branch_from_selected_row "$selected_row"
  fi

  exit
done
