#!/usr/bin/env bash
# Repeatedly fuzzy-select files changed in the current PR and open each as a
# VS Code diff (graphite parent version vs working tree).
# Usage: gdpd [query]
fzf_query="$*"
HELPERS="$(cd "$(dirname "$0")" && pwd)/helpers"
base_ref=$(gt parent)

while true; do
    selected_filename=$("$HELPERS/select_modified_file_in_current_pr" "$fzf_query")
    if [ -n "$selected_filename" ]; then
        basename=$(basename "$selected_filename")
        LEFT="/tmp/__parent__${basename}"

        cleanup() { rm -f "$LEFT"; }
        trap cleanup EXIT

        git show "${base_ref}:${selected_filename}" >"$LEFT" 2>/dev/null || :

        echo "code --diff (parent) (HEAD) -- $selected_filename"
        code --diff "$LEFT" "$selected_filename"
    else
        break
    fi
done
