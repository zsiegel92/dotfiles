gls_require_command() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "$1 not found"
    return 1
  }
}

gls_urlencode() {
  jq -rn --arg value "$1" '$value | @uri'
}

gls_gitlab_username() {
  gls_require_command glab || return
  gls_require_command jq || return
  glab api user | jq -r '.username'
}

gls_api_mrs() {
  local query="$1"
  glab api --paginate "projects/:fullpath/merge_requests?per_page=100&order_by=updated_at&sort=desc&$query"
}

gls_involved_mrs() {
  local state="$1"
  local username="$2"
  local encoded_username
  encoded_username=$(gls_urlencode "$username") || return

  {
    gls_api_mrs "state=$state&author_username=$encoded_username"
    gls_api_mrs "state=$state&assignee_username=$encoded_username"
    gls_api_mrs "state=$state&reviewer_username=$encoded_username"
  } | jq -s 'add // [] | unique_by(.id) | sort_by(.updated_at) | reverse'
}

gls_done_mrs() {
  local username="$1"
  {
    gls_involved_mrs closed "$username"
    gls_involved_mrs merged "$username"
  } | jq -s 'add // [] | unique_by(.id) | sort_by(.updated_at) | reverse'
}

gls_format_mrs() {
  jq -r '
    def red: "\u001b[31m" + . + "\u001b[0m";
    def gray: "\u001b[90m" + . + "\u001b[0m";
    def magenta: "\u001b[35m" + . + "\u001b[0m";
    def merge_state:
      (.detailed_merge_status // .merge_status // "") as $status
      | if ($status == "" or $status == "can_be_merged" or $status == "checking" or $status == "unchecked") then
          ""
        else
          " " + ($status | ascii_upcase | red)
        end;
    def draft_state:
      if (.draft // false) then " " + ("DRAFT" | gray) else "" end;
    def mr_state:
      if .state == "merged" then
        " " + ("MERGED" | magenta)
      elif .state != "opened" then
        " " + (.state | ascii_upcase)
      else
        ""
      end;
    def reviewer_names:
      (.reviewers // [] | map(.username // .name) | join(","));

    .[] |
    "\(.iid) \(.iid)\(merge_state)\(draft_state)\(mr_state) (\(.author.username // "unknown") -> \(if reviewer_names == "" then "no reviewers" else reviewer_names end)): \(.title) - \(.updated_at) \(.source_branch)"
  '
}

gli() {
  case "$1" in
    -h|--help)
      echo "Usage: gli [--all|-a|-r|--done|-d]"
      echo "  default: open merge requests involving you"
      echo "  --all:   all open merge requests in the current GitLab project"
      echo "  -r:      open merge requests requesting your review"
      echo "  --done:  closed or merged merge requests involving you"
      return
      ;;
  esac

  gls_require_command glab || return
  gls_require_command jq || return

  local username
  local encoded_username

  case "$1" in
    --all|-a)
      gls_api_mrs "state=opened" | gls_format_mrs
      ;;
    -r)
      username=$(gls_gitlab_username) || return
      encoded_username=$(gls_urlencode "$username") || return
      gls_api_mrs "state=opened&reviewer_username=$encoded_username" | gls_format_mrs
      ;;
    -d|--done)
      username=$(gls_gitlab_username) || return
      gls_done_mrs "$username" | gls_format_mrs
      ;;
    *)
      username=$(gls_gitlab_username) || return
      gls_involved_mrs opened "$username" | gls_format_mrs
      ;;
  esac
}

wgli() {
  watch --color -n 5 'zsh -ic "gli"'
}

GLS_VIEW_MR_USING_CACHE_COMMAND='tempfile="/tmp/fzgl_mr_{1}.txt"; printf "%s\n\n" {-1}; if [ ! -f "$tempfile" ]; then (COLUMNS=$FZF_PREVIEW_COLUMNS glab mr view {1} > "$tempfile" 2>&1) & fi; count=0; while [ ! -f "$tempfile" ] && [ $count -lt 50 ]; do sleep 0.1; count=$((count + 1)); done; if [ -f "$tempfile" ]; then if command -v bat >/dev/null 2>&1; then bat --color=always --style=plain "$tempfile"; else cat "$tempfile"; fi; else echo "Loading MR !{1}..."; fi'

fzgl() {
  gls_require_command fzf || return
  local mrs
  local mr_iid
  mrs=$(gli "$@") || return

  while true; do
    mr_iid=$(printf '%s\n' "$mrs" | \
      fzf --ansi \
        --preview "$GLS_VIEW_MR_USING_CACHE_COMMAND" \
        --preview-window='right:60%:wrap' \
        --no-mouse \
        --delimiter=' ' \
        --with-nth=2.. \
        --accept-nth=1 \
        --bind="alt-up:preview-up,alt-down:preview-down,alt-u:preview-page-up,alt-d:preview-page-down,page-down:preview-page-down,page-up:preview-page-up"
    )
    if [ -z "$mr_iid" ]; then
      echo "No MR selected"
      return 1
    fi

    (glab mr view "$mr_iid" --web >/dev/null 2>&1 &)
  done
}

showManualGitlabPipelines() {
  gls_require_command glab || return
  gls_require_command jq || return

  local username
  local encoded_username
  username=$(gls_gitlab_username) || return
  encoded_username=$(gls_urlencode "$username") || return

  glab api --paginate "projects/:fullpath/pipelines?per_page=100&order_by=updated_at&sort=desc&username=$encoded_username" \
    | jq '
      def parse_gitlab_date: sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601;
      map(select((now - (.created_at | parse_gitlab_date)) <= (24*60*60)))
      | sort_by(.created_at)
      | map({
          status,
          ref,
          source,
          created_at,
          updated_at,
          web_url,
          name
        })
    '
}

watchManualGitlabPipelines() {
  while true; do
    tput civis
    printf "\033[H"
    printf "Manual GitLab Pipelines\n"
    showManualGitlabPipelines
    sleep 3
  done
}

manualGitlabPipeline() {
  local eval_script="$1"
  if [ -z "$eval_script" ]; then
    echo "Usage: manualGitlabPipeline <eval_script>"
    return 1
  fi

  local branch
  branch=$(git branch --show-current) || return
  glab ci run --branch "$branch" --variables "eval_script:$eval_script"
}
