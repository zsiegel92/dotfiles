#compdef gbs

autoload -Uz _dotfiles_git_branches
_arguments \
  '(-f --full --full-dag --dag -h --handmade --handmade-dag --branch-dag)'{-g,--graph,--tree}'[start in tree view]' \
  '(-g --graph --tree -h --handmade --handmade-dag --branch-dag)'{-f,--full,--full-dag,--dag}'[start in full DAG view]' \
  '(-g --graph --tree -f --full --full-dag --dag)'{-h,--handmade,--handmade-dag,--branch-dag}'[start in handmade branch DAG view]' \
  '(-a --all --all-ancestry)'{-a,--all,--all-ancestry}'[preview all named ancestry instead of stopping at main]' \
  '1:branch query:_dotfiles_git_branches'
