local -a branches expl

(( $+commands[git] )) || return 1
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 1

branches=( ${(f)"$(git for-each-ref --format='%(refname:short)' --sort=-committerdate refs/heads 2>/dev/null)"} )
(( ${#branches} )) || return 1

_wanted branches expl 'local branch' compadd "$expl[@]" -a branches
