
select_git_branch() {
    local query="$1"
    local selected_branch
    selected_branch=$(git branch | fzf \
        --query="$query" \
        --no-mouse \
        --no-sort  \
        --tac \
        --height 90% \
        --ansi \
        --border \
        --wrap \
        --ansi \
        --preview-window=up:3 \
        --preview 'git log --oneline --graph --decorate --color=always --date=short --pretty=format:"%C(auto)%h %ad | %C(reset)%s%C(auto)%d%C(reset)[%an]" $(echo {} | sed "s/^[* ]*//")')
    if [ -n "$selected_branch" ]; then
        echo "$(echo "$selected_branch" | sed 's/^[* ]*//')"
    fi
}

# checkout a branch
gbs() {
    # Pass any arguments to select_git_branch as the query.
    local fzf_query="$*"
    local branch
    branch=$(select_git_branch "$fzf_query")
    if [ -n "$branch" ]; then
        echo "git checkout $branch"
        git checkout "$branch"
    fi
}

# merge a branch
gbm() {
    # Pass any arguments to select_git_branch as the query.
    local fzf_query="$*"
    local branch
    branch=$(select_git_branch "$fzf_query")
    if [ -n "$branch" ]; then
        echo "git merge $branch"
        git merge "$branch"
    fi
}


# copy a branch name
gbc() {
    # Pass any arguments to select_git_branch as the query.
    local fzf_query="$*"
    local branch
    branch=$(select_git_branch "$fzf_query")
    if [ -n "$branch" ]; then
        echo "printf '%s' \"$branch\" | pbcopy"
        printf '%s' "$branch" | pbcopy
    fi
}

# copy current branch name
cgb() {
    local branch
    branch=$(git branch --show-current) || return
    if [ -z "$branch" ]; then
        echo "No current branch" >&2
        return 1
    fi
    echo "printf '%s' \"$branch\" | pbcopy"
    printf '%s' "$branch" | pbcopy
}
