
showManualEvalRuns() {
  username=$(gh api user --jq '.login')
  gh run list --workflow=manual-eval-run.yml \
    --user $username \
    --json status,conclusion,headBranch,createdAt,url \
    | jq '
      map(select((now - (.createdAt | fromdateiso8601)) <= (24*60*60)))
      | sort_by(.createdAt)
      | map(del(.createdAt))
    '
#     --template '{{color "cyan+bold" "STATUS"}}       {{color "cyan+bold" "CONCLUSION"}}  {{color "cyan+bold" "BRANCH"}}                      {{color "cyan+bold" "CREATED"}}
# {{range .}}{{if eq .status "in_progress"}}{{color "yellow" .status}}{{else if eq .status "completed"}}{{color "blue" .status}}{{else}}{{.status}}{{end}}  {{if eq .conclusion "success"}}{{color "green" .conclusion}}{{else if eq .conclusion "failure"}}{{color "red" .conclusion}}{{else}}{{.conclusion}}{{end}}  {{.headBranch}}  {{.createdAt}}
# {{.url}}

# {{end}}'
}

watchManualEvalRuns(){
  while true; do
    tput civis  # hide cursor for less flicker
    printf "\033[H"  # move cursor to top instead of full clear
    printf "Manual Eval Runs\n"
    showManualEvalRuns
    sleep 3
  done
}

manualEvalRun(){
  eval="$1"
  if [ -z "$eval" ]; then
    echo "Usage: manualEvalRun <eval_script>"
    return 1
  fi
  branch=$(git branch --show-current)
  gh workflow run 'Manual Evaluation Run' -f eval_script="$eval" --ref "$branch"
}