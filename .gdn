gdn(){
  git diff --name-only main..HEAD
}
gdno(){
  git diff --name-only origin/main..HEAD
}

select_modified_file_in_current_branch() {
    local query="$1"
    local selected_filename
    selected_filename=$(git diff --name-only main..HEAD | fzf \
        --query="$query" \
        --no-mouse \
        --no-sort  \
        --tac \
        --ansi \
        --border \
        --wrap \
        --ansi \
        --bind alt-up:preview-up,alt-down:preview-down \
        --preview 'git diff --color=always main..HEAD -- {}')
    if [ -n "$selected_filename" ]; then
        echo "$selected_filename"
    fi
}

# copy a modified file in the current branch
gdnc() {
    # Pass any arguments to select_git_branch as the query.
    local fzf_query="$*"
    local selected_filename
    while true; do
        selected_filename=$(select_modified_file_in_current_branch "$fzf_query")
        if [ -n "$selected_filename" ]; then
            echo "printf '%s' \"$selected_filename\" | pbcopy"
            printf '%s' "$selected_filename" | pbcopy
        else
            break
        fi
    done
}
