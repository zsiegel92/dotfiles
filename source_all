# Add this repo's command directories to PATH so all the standalone commands are
# available. Source this from ~/.zshrc:
#   source ~/code/dotfiles/source_all
#
# bin/         the actual commands (where the work happens)
# bin/aliases/ thin wrappers that just delegate to a command in bin/
#
# Run `dotfiles-help` to list every available command.
DOTFILES_DIR="${0:a:h}"
for dir in "$DOTFILES_DIR/bin" "$DOTFILES_DIR/bin/aliases"; do
  case ":$PATH:" in
    *":$dir:"*) ;;
    *) export PATH="$dir:$PATH" ;;
  esac
done

if [ -n "${ZSH_VERSION:-}" ]; then
  for function_file in "$DOTFILES_DIR"/zsh/functions/*.zsh(N); do
    source "$function_file"
  done
  unset function_file

  completion_dir="$DOTFILES_DIR/zsh/completions"
  case " ${fpath[*]} " in
    *" $completion_dir "*) ;;
    *) fpath=("$completion_dir" $fpath) ;;
  esac

  if whence -w compdef >/dev/null 2>&1; then
    autoload -Uz _bring _gbs
    compdef _bring bring gitbring
    compdef _gbs gbs
  fi
  unset completion_dir
fi
