detach_worktree() {
    echo 'git worktree list --porcelain'
    local worktree=$(git worktree list --porcelain | awk '/^worktree /{print $2}' | \
        fzf --preview 'dir={}; git worktree list --porcelain | grep -A2 "^worktree $dir$"')
    if [ -z "$worktree" ]; then
        echo "No worktree selected"
        return 1
    fi
    git -C "$worktree" checkout --detach
}

alias dw=detach_worktree